{
  "description": "Six lifecycle dispatchers with explicit synchronous, maintenance, and manual lanes.",
  "hookLanes": {
    "synchronous": "host-blocking",
    "maintenance": "host-async",
    "manual": [".codex/hooks/archify-preview.mjs"]
  },
  "hookModules": {
    "entrypoints": ["lifecycle.mjs"],
    "handlers": ["ctxroute-reset.mjs", "mission-context.mjs", "post-tool-audit.mjs", "post-tool-crg.mjs", "post-tool-sensor.mjs", "pre-tool-architecture.mjs", "problem-memory.mjs", "stop-review.mjs", "worker-restitution.mjs", "worktree-reconcile.mjs"],
    "libraries": ["decision-memory.mjs", "host-policy-adapter.mjs", "lifecycle-contract.mjs", "path-extraction.mjs", "resolved-policy.mjs"],
    "manual": ["archify-preview.mjs", "ctxroute.mjs"]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ./.codex/hooks/lifecycle.mjs codex SessionStart",
            "timeout": 30,
            "additionalContextLimit": 1200
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ./.codex/hooks/lifecycle.mjs codex PreToolUse",
            "timeout": 45,
            "additionalContextLimit": 1200
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write|exec_command|Bash|Shell",
        "hooks": [
          {
            "type": "command",
            "command": "node ./.codex/hooks/lifecycle.mjs codex PostToolUse",
            "timeout": 45,
            "additionalContextLimit": 1200
          },
          {
            "type": "command",
            "command": "node ./.codex/hooks/lifecycle.mjs codex PostToolUse maintenance",
            "timeout": 30,
            "async": true,
            "additionalContextLimit": 0
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ./.codex/hooks/lifecycle.mjs codex Stop",
            "timeout": 120,
            "additionalContextLimit": 1200
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ./.codex/hooks/lifecycle.mjs codex UserPromptSubmit",
            "timeout": 30,
            "additionalContextLimit": 1200
          },
          {
            "type": "command",
            "command": "node ./.codex/hooks/lifecycle.mjs codex UserPromptSubmit maintenance",
            "timeout": 10,
            "async": true,
            "additionalContextLimit": 0
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ./.codex/hooks/lifecycle.mjs codex PreCompact",
            "timeout": 15,
            "additionalContextLimit": 1200
          }
        ]
      }
    ]
  }
}
