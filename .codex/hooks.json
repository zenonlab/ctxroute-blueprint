{
  "description": "Six minimal lifecycle dispatchers with targeted missions, security checks, cleanup, and passive observability.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ./.codex/hooks/lifecycle.mjs codex SessionStart",
            "timeout": 30,
            "additionalContextLimit": 1600
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ./.codex/hooks/lifecycle.mjs codex PreToolUse",
            "timeout": 45,
            "additionalContextLimit": 1200
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write|exec_command|Bash|Shell",
        "hooks": [
          {
            "type": "command",
            "command": "node ./.codex/hooks/lifecycle.mjs codex PostToolUse",
            "timeout": 45,
            "additionalContextLimit": 1200
          }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node ./.codex/hooks/lifecycle.mjs codex PostToolUse maintenance",
            "timeout": 30,
            "async": true,
            "additionalContextLimit": 1200
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ./.codex/hooks/lifecycle.mjs codex Stop",
            "timeout": 120
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ./.codex/hooks/lifecycle.mjs codex UserPromptSubmit",
            "timeout": 30,
            "additionalContextLimit": 1200
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ./.codex/hooks/lifecycle.mjs codex PreCompact",
            "timeout": 15,
            "additionalContextLimit": 1600
          }
        ]
      }
    ]
  }
}
