{
  "description": "Six portable lifecycle dispatchers for CTXRoute and architecture-first governance.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ./.codex/hooks/lifecycle.mjs codex SessionStart",
            "timeout": 30,
            "additionalContextLimit": 0,
            "statusMessage": "Loading project context"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ./.codex/hooks/lifecycle.mjs codex PreToolUse",
            "timeout": 45,
            "additionalContextLimit": 0,
            "statusMessage": "Checking policy and routing context"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ./.codex/hooks/lifecycle.mjs codex PostToolUse",
            "timeout": 45,
            "additionalContextLimit": 0,
            "statusMessage": "Validating and auditing changes"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ./.codex/hooks/lifecycle.mjs codex Stop",
            "timeout": 120,
            "additionalContextLimit": 0,
            "statusMessage": "Running final step audit"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ./.codex/hooks/lifecycle.mjs codex UserPromptSubmit",
            "timeout": 30,
            "statusMessage": "Updating CTXRoute lifecycle state"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ./.codex/hooks/lifecycle.mjs codex PreCompact",
            "timeout": 15,
            "statusMessage": "Resetting routed context"
          }
        ]
      }
    ]
  }
}
