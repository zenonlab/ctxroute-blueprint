{
  "description": "Ten portable lifecycle dispatchers for CTXRoute, Progress, and architecture-first governance.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ./.codex/hooks/lifecycle.mjs codex SessionStart",
            "timeout": 30,
            "additionalContextLimit": 1200
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ./.codex/hooks/lifecycle.mjs codex PreToolUse",
            "timeout": 45,
            "additionalContextLimit": 1200
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node ./.codex/hooks/lifecycle.mjs codex PostToolUse",
            "timeout": 45,
            "additionalContextLimit": 1200
          },
          {
            "type": "command",
            "command": "node ./.codex/hooks/lifecycle.mjs codex PostToolUse maintenance",
            "timeout": 45,
            "async": true,
            "additionalContextLimit": 1200
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ./.codex/hooks/lifecycle.mjs codex Stop",
            "timeout": 30,
            "additionalContextLimit": 1200
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ./.codex/hooks/lifecycle.mjs codex UserPromptSubmit",
            "timeout": 30,
            "additionalContextLimit": 1200
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ./.codex/hooks/lifecycle.mjs codex PreCompact",
            "timeout": 15,
            "additionalContextLimit": 1200
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ./.codex/hooks/lifecycle.mjs codex PostCompact",
            "timeout": 5,
            "additionalContextLimit": 1200
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^progress[-_]worker$",
        "hooks": [
          {
            "type": "command",
            "command": "node ./.codex/hooks/lifecycle.mjs codex SubagentStart",
            "timeout": 5,
            "additionalContextLimit": 65536
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^progress[-_]worker$",
        "hooks": [
          {
            "type": "command",
            "command": "node ./.codex/hooks/lifecycle.mjs codex SubagentStop",
            "timeout": 5,
            "additionalContextLimit": 1200
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ./.codex/hooks/lifecycle.mjs codex SessionEnd",
            "timeout": 5,
            "additionalContextLimit": 1200
          }
        ]
      }
    ]
  }
}
