{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tobirink-public-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "version_metadata": { "binding": "WORKER_VERSION" },
  "routes": [
    { "pattern": "tobirink.com/*", "zone_name": "tobirink.com" }
  ],
  "assets": {
    "directory": "../web/out",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "PUBLIC_DB",
      "database_name": "tobirink-public",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "COVER_BUCKET",
      "bucket_name": "tobirink-covers"
    },
    {
      "binding": "RELEASE_SNAPSHOTS",
      "bucket_name": "tobirink-public-releases"
    },
    {
      "binding": "DISCOVERY_AUDIT_BUCKET",
      "bucket_name": "tobirink-discovery-audit"
    }
  ],
  "images": {
    "binding": "COVER_IMAGES"
  },
  "ratelimits": [
    {
      "name": "PUBLIC_DISCOVERY_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "PUBLIC_DISCOVERY_READ_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 600, "period": 60 }
    }
  ],
  "queues": {
    "producers": [
      { "binding": "PUBLIC_DISCOVERY_QUEUE", "queue": "tobirink-public-discovery" }
    ],
    "consumers": [
      {
        "queue": "tobirink-public-discovery",
        "max_batch_size": 1,
        "max_batch_timeout": 10,
        "max_concurrency": 1,
        "max_retries": 8,
        "dead_letter_queue": "tobirink-public-discovery-dlq"
      }
    ]
  },
  "triggers": {
    "crons": ["23 3 * * SUN", "*/10 * * * *"]
  },
  "vars": {
    "PROVIDER_GATEWAY_ORIGIN": "https://tobirink-provider-gateway.tobirink.deno.net",
    "PROVIDER_TRANSPORT_MODE": "selective-gateway",
    "DISCOVERY_DELIVERY_MODE": "worker-direct",
    "TOBIRINK_WORKER_DIAGNOSTICS": "worker-v1"
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
