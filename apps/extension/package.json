{
  "name": "@favlib/extension",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node node_modules/wxt/bin/wxt.mjs",
    "build": "node node_modules/wxt/bin/wxt.mjs build --mv3 && node node_modules/wxt/bin/wxt.mjs build -b firefox --mv3",
    "lint": "node node_modules/typescript/bin/tsc --noEmit",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": { "@favlib/contracts": "workspace:*" },
  "devDependencies": { "@types/chrome": "^0.0.280", "typescript": "^5.7.3", "vitest": "^2.1.8", "wxt": "^0.19.20" }
}
