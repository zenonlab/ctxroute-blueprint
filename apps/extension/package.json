    "@tobirink/adapters-indexeddb": "*",
    "@tobirink/application": "*",
    "@tobirink/contracts": "*",
    "@tobirink/ui": "*",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.10.15",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@wxt-dev/module-react": "1.2.2",
    "wxt": "0.21.4",
    "vitest": "4.1.11"
  }
}
