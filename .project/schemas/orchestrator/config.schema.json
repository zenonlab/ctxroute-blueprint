{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctxroute.dev/schemas/orchestrator/config.schema.json",
  "type": "object",
  "required": ["defaultMode", "statePath", "worktreeRoot", "recoveryRoot", "telemetryPath", "workerRuntime", "limits"],
  "properties": {
    "defaultMode": { "enum": ["SWARM_ON", "SWARM_OFF"] },
    "statePath": { "$ref": "common.schema.json#/$defs/relativePath" },
    "worktreeRoot": { "$ref": "common.schema.json#/$defs/relativePath" },
    "recoveryRoot": { "$ref": "common.schema.json#/$defs/relativePath" },
    "telemetryPath": { "$ref": "common.schema.json#/$defs/relativePath" },
    "workerRuntime": { "enum": ["auto", "codex", "claude", "gemini"] },
    "modelRouting": {
      "type": "object",
      "required": ["mode", "defaultPreset", "catalog", "profiles", "riskFloors", "evaluation", "documentation"],
      "properties": {
        "mode": { "enum": ["legacy", "adaptive"] },
        "defaultPreset": { "enum": ["economy", "balanced", "quality", "custom"] },
        "catalog": { "type": "array", "maxItems": 128, "items": { "$ref": "model-descriptor.schema.json" } },
        "profiles": {
          "type": "object",
          "propertyNames": { "enum": ["research", "planning", "work", "skillCreation", "skillAudit", "repair", "goalAudit", "conflictAnalysis", "synthesis"] },
          "additionalProperties": {
            "type": "object",
            "required": ["minimum_level", "timeout_ms", "attempts", "fallback", "independence"],
            "properties": {
              "minimum_level": { "enum": ["L0", "L1", "L2", "L3", "L4"] },
              "effort": { "enum": ["none", "low", "medium", "high", "xhigh", "max"] },
              "timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 3600000 },
              "attempts": { "type": "integer", "minimum": 1, "maximum": 8 },
              "fallback": { "type": "boolean" },
              "independence": { "type": "boolean" }
            },
            "unevaluatedProperties": false
          }
        },
        "riskFloors": {
          "type": "object",
          "propertyNames": { "enum": ["routine", "feature", "bugfix", "security", "migration", "incident", "audit"] },
          "additionalProperties": { "enum": ["L0", "L1", "L2", "L3", "L4"] }
        },
        "evaluation": {
          "type": "object",
          "required": ["minimumSamples", "allowAutomaticPromotion"],
          "properties": { "minimumSamples": { "type": "integer", "minimum": 1, "maximum": 10000 }, "allowAutomaticPromotion": { "const": false } },
          "unevaluatedProperties": false
        },
        "documentation": {
          "type": "object",
          "required": ["required", "defaultFreshness", "volatileFreshness", "primarySourcesRequired", "blockWhenUnavailable"],
          "properties": {
            "required": { "type": "boolean" },
            "defaultFreshness": { "const": "per-goal" },
            "volatileFreshness": { "const": "per-dispatch" },
            "primarySourcesRequired": { "type": "boolean" },
            "blockWhenUnavailable": { "type": "boolean" }
          },
          "unevaluatedProperties": false
        }
      },
      "unevaluatedProperties": false
    },
    "limits": {
      "type": "object",
      "required": ["stateBytes", "reportBytes", "contextBytes", "lockTimeoutMs", "subprocessTimeoutMs", "goalTimeoutMs", "workerTimeoutMs", "parallelWorktrees", "workerStdoutBytes", "workerStderrBytes", "minimumFreeBytes", "telemetryBytes", "recoveryBytes", "auditTraceBytes", "auditTraceFiles"],
      "properties": {
        "stateBytes": { "type": "integer", "minimum": 65536, "maximum": 4194304 },
        "reportBytes": { "type": "integer", "minimum": 4096, "maximum": 1048576 },
        "contextBytes": { "type": "integer", "minimum": 1024, "maximum": 262144 },
        "lockTimeoutMs": { "type": "integer", "minimum": 100, "maximum": 30000 },
        "subprocessTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 300000 },
        "goalTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 86400000 },
        "workerTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 3600000 },
        "parallelWorktrees": { "type": "integer", "minimum": 1, "maximum": 64 },
        "workerStdoutBytes": { "type": "integer", "minimum": 4096, "maximum": 1048576 },
        "workerStderrBytes": { "type": "integer", "minimum": 1024, "maximum": 262144 },
        "minimumFreeBytes": { "type": "integer", "minimum": 16777216, "maximum": 17179869184 },
        "telemetryBytes": { "type": "integer", "minimum": 65536, "maximum": 16777216 },
        "recoveryBytes": { "type": "integer", "minimum": 1048576, "maximum": 268435456 },
        "auditTraceBytes": { "type": "integer", "minimum": 65536, "maximum": 16777216 },
        "auditTraceFiles": { "type": "integer", "minimum": 1, "maximum": 256 }
      },
      "unevaluatedProperties": false
    }
  },
  "unevaluatedProperties": false
}
