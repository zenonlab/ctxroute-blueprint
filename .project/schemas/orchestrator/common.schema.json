{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctxroute.dev/schemas/orchestrator/common.schema.json",
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$" },
    "relativePath": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*[\\u0000-\\u001f])[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*/?$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "gitOid": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "timestamp": { "type": "string", "minLength": 20, "maxLength": 35, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[^\\u0000]*$" },
    "nullableCause": { "type": ["string", "null"], "minLength": 1, "maxLength": 128, "pattern": "^[A-Z][A-Z0-9_]*$" },
    "validation": {
      "type": "object",
      "required": ["id", "executable", "args", "cwd", "timeout_ms"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "executable": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f]+$" },
        "args": { "type": "array", "maxItems": 64, "items": { "type": "string", "maxLength": 2048, "pattern": "^[^\\u0000-\\u001f]*$" } },
        "cwd": { "$ref": "#/$defs/relativePath" },
        "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 300000 }
      },
      "unevaluatedProperties": false
    },
    "validationResult": {
      "type": "object",
      "required": ["id", "status", "exit_code", "duration_ms", "timed_out", "cause", "diagnostic"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "status": { "enum": ["PASSED", "FAILED", "TIMED_OUT", "NOT_RUN"] },
        "exit_code": { "type": ["integer", "null"], "minimum": 0, "maximum": 255 },
        "duration_ms": { "type": "integer", "minimum": 0, "maximum": 300000 },
        "timed_out": { "type": "boolean" },
        "cause": { "$ref": "#/$defs/nullableCause" },
        "diagnostic": { "type": ["string", "null"], "maxLength": 1024, "pattern": "^[^\\u0000]*$" }
      },
      "unevaluatedProperties": false
    },
    "worktreeAllocation": {
      "type": "object",
      "required": ["path", "base_revision", "status", "recovery_proof"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "base_revision": { "$ref": "#/$defs/gitOid" },
        "status": { "enum": ["ACTIVE", "NEEDS_ATTENTION", "REMOVED", "ROLLED_BACK"] },
        "recovery_proof": { "oneOf": [{ "$ref": "#/$defs/relativePath" }, { "type": "null" }] }
      },
      "unevaluatedProperties": false
    }
  }
}
