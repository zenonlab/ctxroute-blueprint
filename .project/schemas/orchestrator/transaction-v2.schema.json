{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctxroute.dev/schemas/orchestrator/transaction-v2.schema.json",
  "type": "object",
  "required": ["operation_id", "expected_revision", "action", "payload"],
  "properties": {
    "operation_id": { "$ref": "common-v2.schema.json#/$defs/identifier" },
    "expected_revision": { "type": "integer", "minimum": 0 },
    "action": { "enum": ["mode.set", "goal.create", "goal.transition", "mission.prepare", "mission.transition", "report.submit", "audit.apply", "skill.register", "worktree.reconcile", "mission.rollback", "worktree.purge"] },
    "payload": { "type": "object" }
  },
  "oneOf": [
    { "properties": { "action": { "const": "mode.set" }, "payload": { "$ref": "#/$defs/modeSet" } } },
    { "properties": { "action": { "const": "goal.create" }, "payload": { "$ref": "#/$defs/goalCreate" } } },
    { "properties": { "action": { "const": "goal.transition" }, "payload": { "$ref": "#/$defs/goalTransition" } } },
    { "properties": { "action": { "const": "mission.prepare" }, "payload": { "$ref": "#/$defs/missionPrepare" } } },
    { "properties": { "action": { "const": "mission.transition" }, "payload": { "$ref": "#/$defs/missionTransition" } } },
    { "properties": { "action": { "const": "report.submit" }, "payload": { "$ref": "#/$defs/reportSubmit" } } },
    { "properties": { "action": { "const": "audit.apply" }, "payload": { "$ref": "#/$defs/auditApply" } } },
    { "properties": { "action": { "const": "skill.register" }, "payload": { "$ref": "#/$defs/skillRegister" } } },
    { "properties": { "action": { "const": "worktree.reconcile" }, "payload": { "$ref": "#/$defs/reconcile" } } },
    { "properties": { "action": { "const": "mission.rollback" }, "payload": { "$ref": "#/$defs/rollback" } } },
    { "properties": { "action": { "const": "worktree.purge" }, "payload": { "$ref": "#/$defs/purge" } } }
  ],
  "$defs": {
    "modeSet": { "type": "object", "required": ["mode"], "properties": { "mode": { "enum": ["SWARM_ON", "SWARM_OFF"] } }, "unevaluatedProperties": false },
    "goalCreate": { "type": "object", "required": ["goal_id", "title"], "properties": { "goal_id": { "$ref": "common-v2.schema.json#/$defs/identifier" }, "title": { "$ref": "common-v2.schema.json#/$defs/text" } }, "unevaluatedProperties": false },
    "goalTransition": { "type": "object", "required": ["goal_id", "status"], "properties": { "goal_id": { "$ref": "common-v2.schema.json#/$defs/identifier" }, "status": { "enum": ["COMPLETED", "CANCELLED"] } }, "unevaluatedProperties": false },
    "missionPrepare": { "type": "object", "required": ["goal_id", "mission"], "properties": { "goal_id": { "$ref": "common-v2.schema.json#/$defs/identifier" }, "mission": { "$ref": "mission-request-v2.schema.json" } }, "unevaluatedProperties": false },
    "missionTransition": { "type": "object", "required": ["goal_id", "mission_id", "status"], "properties": { "goal_id": { "$ref": "common-v2.schema.json#/$defs/identifier" }, "mission_id": { "$ref": "common-v2.schema.json#/$defs/identifier" }, "status": { "enum": ["ASSIGNED", "RUNNING", "BLOCKED", "COMPLETED", "CANCELLED"] } }, "unevaluatedProperties": false },
    "reportSubmit": { "type": "object", "required": ["goal_id", "report"], "properties": { "goal_id": { "$ref": "common-v2.schema.json#/$defs/identifier" }, "report": { "$ref": "worker-report-v2.schema.json" } }, "unevaluatedProperties": false },
    "auditApply": { "type": "object", "required": ["report"], "properties": { "report": { "$ref": "audit-report-v2.schema.json" } }, "unevaluatedProperties": false },
    "skillRegister": { "type": "object", "required": ["skill_id", "version", "path", "artifact_digest", "validation_receipt", "audit_id"], "properties": { "skill_id": { "$ref": "common-v2.schema.json#/$defs/identifier" }, "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "maxLength": 32 }, "path": { "$ref": "common-v2.schema.json#/$defs/relativePath" }, "artifact_digest": { "$ref": "common-v2.schema.json#/$defs/digest" }, "validation_receipt": { "$ref": "validation-receipt-v2.schema.json" }, "audit_id": { "$ref": "common-v2.schema.json#/$defs/identifier" } }, "unevaluatedProperties": false },
    "reconcile": { "type": "object", "required": ["repair"], "properties": { "repair": { "type": "boolean" } }, "unevaluatedProperties": false },
    "rollback": { "type": "object", "required": ["goal_id", "mission_id", "reason"], "properties": { "goal_id": { "$ref": "common-v2.schema.json#/$defs/identifier" }, "mission_id": { "$ref": "common-v2.schema.json#/$defs/identifier" }, "reason": { "$ref": "common-v2.schema.json#/$defs/text" } }, "unevaluatedProperties": false },
    "purge": { "type": "object", "required": ["goal_id", "mission_id", "reason", "confirmation"], "properties": { "goal_id": { "$ref": "common-v2.schema.json#/$defs/identifier" }, "mission_id": { "$ref": "common-v2.schema.json#/$defs/identifier" }, "reason": { "$ref": "common-v2.schema.json#/$defs/text" }, "confirmation": { "$ref": "common-v2.schema.json#/$defs/identifier" } }, "unevaluatedProperties": false }
  },
  "unevaluatedProperties": false
}
