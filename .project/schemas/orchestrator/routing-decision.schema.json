{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctxroute.dev/schemas/orchestrator/routing-decision.schema.json",
  "type": "object",
  "required": ["decision_id", "phase", "level", "selected", "effort", "access_mode", "required_capabilities", "cascade", "rejected", "independence_required", "reason"],
  "properties": {
    "decision_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "phase": { "enum": ["research", "planning", "work", "skillCreation", "skillAudit", "repair", "goalAudit", "conflictAnalysis", "synthesis"] },
    "level": { "enum": ["L0", "L1", "L2", "L3", "L4"] },
    "selected": { "oneOf": [{ "type": "object", "required": ["adapter", "model_id", "provider_family"], "properties": { "adapter": { "enum": ["codex", "claude", "gemini", "fixture"] }, "model_id": { "$ref": "common.schema.json#/$defs/identifier" }, "provider_family": { "$ref": "common.schema.json#/$defs/identifier" } }, "unevaluatedProperties": false }, { "type": "null" }] },
    "effort": { "enum": ["none", "low", "medium", "high", "xhigh", "max"] },
    "access_mode": { "enum": ["read-only", "workspace-write"] },
    "required_capabilities": { "type": "array", "maxItems": 8, "uniqueItems": true, "items": { "enum": ["code", "reasoning", "long-context", "structured-output", "web-research"] } },
    "cascade": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "type": "object", "required": ["source", "effect"], "properties": { "source": { "$ref": "common.schema.json#/$defs/identifier" }, "effect": { "$ref": "common.schema.json#/$defs/text" } }, "unevaluatedProperties": false } },
    "rejected": { "type": "array", "maxItems": 128, "items": { "type": "object", "required": ["adapter", "model_id", "causes"], "properties": { "adapter": { "enum": ["codex", "claude", "gemini", "fixture"] }, "model_id": { "$ref": "common.schema.json#/$defs/identifier" }, "causes": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/identifier" } } }, "unevaluatedProperties": false } },
    "independence_required": { "type": "boolean" },
    "reason": { "$ref": "common.schema.json#/$defs/text" }
  },
  "unevaluatedProperties": false
}
