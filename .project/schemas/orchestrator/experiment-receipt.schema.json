{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://ctxroute.dev/schemas/orchestrator/experiment-receipt.schema.json",
  "type": "object", "required": ["receipt_id", "goal_id", "policy_digest", "worktree", "status", "evidence_refs", "created_at"],
  "properties": {
    "receipt_id": { "$ref": "common.schema.json#/$defs/identifier" }, "goal_id": { "$ref": "common.schema.json#/$defs/identifier" }, "policy_digest": { "$ref": "common.schema.json#/$defs/digest" },
    "worktree": { "$ref": "common.schema.json#/$defs/relativePath" }, "status": { "const": "READY_FOR_PROMOTION" }, "evidence_refs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/relativePath" } },
    "created_at": { "$ref": "common.schema.json#/$defs/timestamp" }
  }, "unevaluatedProperties": false
}
