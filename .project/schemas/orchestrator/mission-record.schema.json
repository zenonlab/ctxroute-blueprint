{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctxroute.dev/schemas/orchestrator/mission-record.schema.json",
  "type": "object",
  "required": ["mission_id", "skill_id", "requested_skill_id", "skill_version", "file_scope", "acceptance", "validations", "response_format", "execution", "execution_reason", "status", "worktree_allocation", "report", "validation_receipt"],
  "properties": {
    "mission_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "skill_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "requested_skill_id": { "oneOf": [{ "$ref": "common.schema.json#/$defs/identifier" }, { "type": "null" }] },
    "skill_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "maxLength": 32 },
    "file_scope": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/relativePath" } },
    "acceptance": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/text" } },
    "validations": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/validation" } },
    "response_format": { "const": "worker-report" },
    "execution": { "enum": ["auto", "direct", "coordinated"] },
    "execution_reason": { "enum": ["ENVIRONMENT_SWARM_OFF", "EXPLICIT_DIRECT", "EXPLICIT_COORDINATED", "AUTO_SINGLE_SCOPE", "AUTO_COORDINATED", "PERSISTED_MODE", "DEFAULT_MODE"] },
    "status": { "enum": ["PREPARING", "ASSIGNED", "RUNNING", "BLOCKED", "COMPLETED", "CANCELLED"] },
    "worktree_allocation": { "oneOf": [{ "$ref": "common.schema.json#/$defs/worktreeAllocation" }, { "type": "null" }] },
    "report": { "oneOf": [{ "$ref": "worker-report.schema.json" }, { "type": "null" }] },
    "validation_receipt": { "oneOf": [{ "$ref": "validation-receipt.schema.json" }, { "type": "null" }] }
  },
  "unevaluatedProperties": false
}
