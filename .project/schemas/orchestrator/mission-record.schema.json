{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctxroute.dev/schemas/orchestrator/mission-record.schema.json",
  "type": "object",
  "required": ["mission_id", "skill_id", "requested_skill_id", "skill_version", "file_scope", "acceptance", "validations", "response_format", "execution", "execution_reason", "stage", "strategy", "access", "policy_digest", "reinforcements", "status", "worktree_allocation", "orchestrator_commit", "integrated_commit", "report", "validation_receipt"],
  "properties": {
    "mission_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "skill_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "requested_skill_id": { "oneOf": [{ "$ref": "common.schema.json#/$defs/identifier" }, { "type": "null" }] },
    "skill_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "maxLength": 32 },
    "file_scope": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/relativePath" } },
    "acceptance": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/text" } },
    "validations": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/validation" } },
    "response_format": { "const": "worker-report" },
    "execution": { "enum": ["auto", "direct", "coordinated"] },
    "execution_reason": { "enum": ["ENVIRONMENT_SWARM_OFF", "EXPLICIT_DIRECT", "EXPLICIT_COORDINATED", "AUTO_SINGLE_SCOPE", "AUTO_COORDINATED", "PERSISTED_MODE", "DEFAULT_MODE"] },
    "stage": { "enum": ["inventory", "research", "decision", "planning", "work", "validation", "audit", "integration", "recovery", "promotion"] },
    "strategy": { "enum": ["deterministic", "primary", "single-worker", "parallel-workers", "independent-auditor", "human-decision"] },
    "access": { "enum": ["read-only", "write"] },
    "policy_digest": { "$ref": "common.schema.json#/$defs/digest" },
    "reinforcements": { "type": "array", "uniqueItems": true, "items": { "type": "string", "maxLength": 512 } },
    "status": { "enum": ["PREPARING", "ASSIGNED", "RUNNING", "BLOCKED", "COMPLETED", "CANCELLED"] },
    "worktree_allocation": { "oneOf": [{ "$ref": "common.schema.json#/$defs/worktreeAllocation" }, { "type": "null" }] },
    "orchestrator_commit": { "oneOf": [{ "$ref": "common.schema.json#/$defs/gitOid" }, { "type": "null" }] },
    "integrated_commit": { "oneOf": [{ "$ref": "common.schema.json#/$defs/gitOid" }, { "type": "null" }] },
    "report": { "oneOf": [{ "$ref": "worker-report.schema.json" }, { "type": "null" }] },
    "validation_receipt": { "oneOf": [{ "$ref": "validation-receipt.schema.json" }, { "type": "null" }] }
    ,"attempt": { "oneOf": [{ "type": "null" }, { "type": "object", "required": ["attempt_id", "adapter", "supervisor_pid", "started_at", "finished_at", "status", "cause"], "properties": { "attempt_id": { "$ref": "common.schema.json#/$defs/identifier" }, "adapter": { "enum": ["codex", "claude", "opencode"] }, "supervisor_pid": { "type": "integer", "minimum": 1 }, "started_at": { "$ref": "common.schema.json#/$defs/timestamp" }, "finished_at": { "oneOf": [{ "$ref": "common.schema.json#/$defs/timestamp" }, { "type": "null" }] }, "status": { "enum": ["RUNNING", "SUCCEEDED", "BLOCKED"] }, "cause": { "oneOf": [{ "type": "string", "pattern": "^[A-Z_]{1,64}$" }, { "type": "null" }] } }, "unevaluatedProperties": false }] }
  },
  "unevaluatedProperties": false
}
