{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctxroute.dev/schemas/orchestrator/audit-report-v2.schema.json",
  "type": "object",
  "required": ["schemaVersion", "audit_id", "audit_type", "subject", "signals", "decision", "evidence_refs", "proposed_action", "applied_action", "validations", "rollback_ref"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "audit_id": { "$ref": "common-v2.schema.json#/$defs/identifier" },
    "audit_type": { "enum": ["blueprint-audit", "session-audit", "mission-audit", "skill-audit"] },
    "subject": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": { "enum": ["blueprint", "session", "mission", "skill", "worktree"] },
        "id": { "$ref": "common-v2.schema.json#/$defs/identifier" }
      },
      "unevaluatedProperties": false
    },
    "signals": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9-]*$" } },
    "decision": { "enum": ["accept", "repair", "reject", "defer"] },
    "evidence_refs": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "common-v2.schema.json#/$defs/relativePath" } },
    "proposed_action": { "type": ["string", "null"], "maxLength": 1024, "pattern": "^[^\\u0000]*$" },
    "applied_action": { "type": ["string", "null"], "maxLength": 1024, "pattern": "^[^\\u0000]*$" },
    "validations": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "common-v2.schema.json#/$defs/validationResult" } },
    "rollback_ref": { "oneOf": [{ "$ref": "common-v2.schema.json#/$defs/relativePath" }, { "type": "null" }] }
  },
  "unevaluatedProperties": false
}
