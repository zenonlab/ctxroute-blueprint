{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctxroute.dev/schemas/orchestrator/documentation-source.schema.json",
  "type": "object",
  "required": ["source_id", "requirement_ids", "url", "domain", "authority", "title", "version", "accessed_at", "digest", "claims"],
  "properties": {
    "source_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "requirement_ids": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/identifier" } },
    "url": { "type": "string", "maxLength": 1024, "pattern": "^https://[^\\u0000-\\u001f]+$" },
    "domain": { "type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[A-Za-z0-9.-]+$" },
    "authority": { "enum": ["official", "primary-standard", "official-repository", "secondary"] },
    "title": { "$ref": "common.schema.json#/$defs/text" },
    "version": { "type": ["string", "null"], "maxLength": 128, "pattern": "^[^\\u0000-\\u001f]*$" },
    "accessed_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "digest": { "$ref": "common.schema.json#/$defs/digest" },
    "claims": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/text" } }
  },
  "unevaluatedProperties": false
}
