{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://ctxroute.dev/schemas/orchestrator/decision-request.schema.json",
  "type": "object", "required": ["decision_id", "goal_id", "policy_digest", "category", "prompt", "allowed_alternatives", "status", "created_at"],
  "properties": {
    "decision_id": { "$ref": "common.schema.json#/$defs/identifier" }, "goal_id": { "$ref": "common.schema.json#/$defs/identifier" }, "policy_digest": { "$ref": "common.schema.json#/$defs/digest" },
    "category": { "type": "string" }, "prompt": { "$ref": "common.schema.json#/$defs/text" }, "allowed_alternatives": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "status": { "enum": ["PENDING", "RESOLVED"] }, "created_at": { "$ref": "common.schema.json#/$defs/timestamp" }
  }, "unevaluatedProperties": false
}
