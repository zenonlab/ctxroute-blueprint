{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctxroute.dev/schemas/orchestrator/mission-request-v2.schema.json",
  "type": "object",
  "required": ["mission_id", "skill_id", "requested_skill_id", "skill_version", "file_scope", "acceptance", "validations", "execution"],
  "properties": {
    "mission_id": { "$ref": "common-v2.schema.json#/$defs/identifier" },
    "skill_id": { "$ref": "common-v2.schema.json#/$defs/identifier" },
    "requested_skill_id": { "oneOf": [{ "$ref": "common-v2.schema.json#/$defs/identifier" }, { "type": "null" }] },
    "skill_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "maxLength": 32 },
    "file_scope": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "$ref": "common-v2.schema.json#/$defs/relativePath" } },
    "acceptance": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "$ref": "common-v2.schema.json#/$defs/text" } },
    "validations": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "common-v2.schema.json#/$defs/validation" } },
    "execution": { "enum": ["auto", "direct", "coordinated"] }
  },
  "unevaluatedProperties": false
}
