{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctxroute.dev/schemas/orchestrator/workflow-descriptor.schema.json",
  "type": "object", "required": ["workflow", "read_only", "terminal_status", "stages"],
  "properties": {
    "workflow": { "enum": ["STANDARD", "RESEARCH", "AUDIT", "SECURITY", "MIGRATION", "INCIDENT", "EXPERIMENT", "RECOVERY"] },
    "read_only": { "type": "boolean" }, "terminal_status": { "enum": ["COMPLETED", "READY_FOR_PROMOTION"] },
    "stages": { "type": "array", "minItems": 1, "items": { "$ref": "stage-plan.schema.json" } }
  }, "unevaluatedProperties": false
}
