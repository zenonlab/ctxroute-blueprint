{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctxroute.dev/schemas/orchestrator/goal-acceptance-report.schema.json",
  "type": "object",
  "required": ["goal_id", "decision", "criteria", "repair_missions", "summary"],
  "properties": {
    "goal_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "decision": { "enum": ["accept", "repair", "reject"] },
    "criteria": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/criterion" } },
    "repair_missions": { "type": "array", "maxItems": 64, "items": { "$ref": "goal-plan.schema.json#/$defs/mission" } },
    "summary": { "$ref": "common.schema.json#/$defs/text" }
  },
  "$defs": {
    "criterion": {
      "type": "object",
      "required": ["criterion_id", "status", "evidence_refs", "mission_ids"],
      "properties": {
        "criterion_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "status": { "enum": ["PROVED", "MISSING"] },
        "evidence_refs": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/relativePath" } },
        "mission_ids": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/identifier" } }
      },
      "unevaluatedProperties": false
    }
  },
  "unevaluatedProperties": false
}
