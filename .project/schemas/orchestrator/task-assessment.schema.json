{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctxroute.dev/schemas/orchestrator/task-assessment.schema.json",
  "type": "object",
  "required": ["assessment_id", "importance", "change_kind", "minimum_level", "context_class", "risk_signals", "reproducibility", "validation_strength", "rollback", "ambiguity", "failure_count", "reasons"],
  "properties": {
    "assessment_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "importance": { "enum": ["low", "normal", "high", "critical"] },
    "change_kind": { "enum": ["routine", "feature", "bugfix", "security", "migration", "incident", "audit"] },
    "minimum_level": { "enum": ["L0", "L1", "L2", "L3", "L4"] },
    "context_class": { "enum": ["small", "medium", "large", "xlarge"] },
    "risk_signals": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "enum": ["public-api", "authentication", "permissions", "secrets", "data", "concurrency", "infrastructure", "distributed", "intermittent", "irreversible", "cross-component", "external-dependency"] } },
    "reproducibility": { "enum": ["not-applicable", "reproduced", "not-reproduced", "intermittent"] },
    "validation_strength": { "enum": ["none", "weak", "moderate", "strong"] },
    "rollback": { "enum": ["easy", "bounded", "difficult", "irreversible"] },
    "ambiguity": { "enum": ["low", "medium", "high"] },
    "failure_count": { "type": "integer", "minimum": 0, "maximum": 32 },
    "reasons": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/text" } }
  },
  "unevaluatedProperties": false
}
