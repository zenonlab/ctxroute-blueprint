{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctxroute.dev/schemas/orchestrator/transaction.schema.json",
  "type": "object",
  "required": ["operation_id", "expected_revision", "action", "payload"],
  "properties": {
    "operation_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "expected_revision": { "type": "integer", "minimum": 0 },
    "action": { "enum": ["operating-mode.set", "mode.set", "goal.create", "goal.stage.advance", "goal.transition", "goal.policy.rebase", "decision.request", "decision.resolve", "experiment.promote", "mission.prepare", "mission.commit", "mission.integrate", "mission.transition", "report.submit", "audit.apply", "skill.register", "worktree.reconcile", "mission.rollback", "worktree.purge"] },
    "payload": { "type": "object" }
  },
  "oneOf": [
    { "properties": { "action": { "const": "mode.set" }, "payload": { "$ref": "#/$defs/modeSet" } } },
    { "properties": { "action": { "const": "operating-mode.set" }, "payload": { "$ref": "#/$defs/canonicalModeSet" } } },
    { "properties": { "action": { "const": "goal.create" }, "payload": { "$ref": "#/$defs/goalCreate" } } },
    { "properties": { "action": { "const": "goal.stage.advance" }, "payload": { "$ref": "#/$defs/stageAdvance" } } },
    { "properties": { "action": { "const": "goal.transition" }, "payload": { "$ref": "#/$defs/goalTransition" } } },
    { "properties": { "action": { "const": "goal.policy.rebase" }, "payload": { "$ref": "#/$defs/policyRebase" } } },
    { "properties": { "action": { "const": "decision.request" }, "payload": { "$ref": "#/$defs/decisionRequest" } } },
    { "properties": { "action": { "const": "decision.resolve" }, "payload": { "$ref": "#/$defs/decisionResolve" } } },
    { "properties": { "action": { "const": "experiment.promote" }, "payload": { "$ref": "#/$defs/experimentPromote" } } },
    { "properties": { "action": { "const": "mission.prepare" }, "payload": { "$ref": "#/$defs/missionPrepare" } } },
    { "properties": { "action": { "const": "mission.commit" }, "payload": { "$ref": "#/$defs/missionCommit" } } },
    { "properties": { "action": { "const": "mission.integrate" }, "payload": { "$ref": "#/$defs/missionIntegrate" } } },
    { "properties": { "action": { "const": "mission.transition" }, "payload": { "$ref": "#/$defs/missionTransition" } } },
    { "properties": { "action": { "const": "report.submit" }, "payload": { "$ref": "#/$defs/reportSubmit" } } },
    { "properties": { "action": { "const": "audit.apply" }, "payload": { "$ref": "#/$defs/auditApply" } } },
    { "properties": { "action": { "const": "skill.register" }, "payload": { "$ref": "#/$defs/skillRegister" } } },
    { "properties": { "action": { "const": "worktree.reconcile" }, "payload": { "$ref": "#/$defs/reconcile" } } },
    { "properties": { "action": { "const": "mission.rollback" }, "payload": { "$ref": "#/$defs/rollback" } } },
    { "properties": { "action": { "const": "worktree.purge" }, "payload": { "$ref": "#/$defs/purge" } } }
  ],
  "$defs": {
    "modeSet": { "type": "object", "required": ["mode"], "properties": { "mode": { "enum": ["SWARM", "AUTO", "SOLO", "GUARDED", "DIRECT", "SWARM_ON", "SWARM_OFF"] } }, "unevaluatedProperties": false },
    "canonicalModeSet": { "type": "object", "required": ["mode"], "properties": { "mode": { "enum": ["SWARM", "AUTO", "SOLO", "GUARDED", "DIRECT"] } }, "unevaluatedProperties": false },
    "goalCreate": { "type": "object", "required": ["goal_id", "title"], "properties": { "goal_id": { "$ref": "common.schema.json#/$defs/identifier" }, "title": { "$ref": "common.schema.json#/$defs/text" }, "requested_mode": { "enum": ["SWARM", "AUTO", "SOLO", "GUARDED", "DIRECT"] }, "workflow": { "enum": ["STANDARD", "RESEARCH", "AUDIT", "SECURITY", "MIGRATION", "INCIDENT", "EXPERIMENT", "RECOVERY"] }, "capabilities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }, "repository_baseline": { "oneOf": [{ "type": "null" }, { "type": "object", "required": ["head", "status_digest"], "properties": { "head": { "$ref": "common.schema.json#/$defs/gitOid" }, "status_digest": { "$ref": "common.schema.json#/$defs/digest" } }, "unevaluatedProperties": false }] } }, "unevaluatedProperties": false },
    "stageAdvance": { "type": "object", "required": ["goal_id", "checkpoint"], "properties": { "goal_id": { "$ref": "common.schema.json#/$defs/identifier" }, "checkpoint": { "$ref": "stage-checkpoint.schema.json" }, "experiment_receipt": { "$ref": "experiment-receipt.schema.json" } }, "unevaluatedProperties": false },
    "goalTransition": { "type": "object", "required": ["goal_id", "status"], "properties": { "goal_id": { "$ref": "common.schema.json#/$defs/identifier" }, "status": { "enum": ["WAITING_FOR_USER_DECISION", "READY_FOR_PROMOTION", "COMPLETED", "CANCELLED"] }, "outcome_receipt": { "$ref": "outcome-receipt.schema.json" } }, "unevaluatedProperties": false },
    "policyRebase": { "type": "object", "required": ["goal_id", "checkpoint_id", "expected_policy_digest", "policy"], "properties": { "goal_id": { "$ref": "common.schema.json#/$defs/identifier" }, "checkpoint_id": { "$ref": "common.schema.json#/$defs/identifier" }, "expected_policy_digest": { "$ref": "common.schema.json#/$defs/digest" }, "policy": { "$ref": "resolved-execution-policy.schema.json" } }, "unevaluatedProperties": false },
    "decisionRequest": { "type": "object", "required": ["request", "checkpoint"], "properties": { "request": { "$ref": "decision-request.schema.json" }, "checkpoint": { "$ref": "stage-checkpoint.schema.json" } }, "unevaluatedProperties": false },
    "decisionResolve": { "type": "object", "required": ["receipt"], "properties": { "receipt": { "$ref": "decision-receipt.schema.json" } }, "unevaluatedProperties": false },
    "experimentPromote": { "type": "object", "required": ["goal_id", "decision_receipt_id"], "properties": { "goal_id": { "$ref": "common.schema.json#/$defs/identifier" }, "decision_receipt_id": { "$ref": "common.schema.json#/$defs/identifier" } }, "unevaluatedProperties": false },
    "missionPrepare": { "type": "object", "required": ["goal_id", "mission"], "properties": { "goal_id": { "$ref": "common.schema.json#/$defs/identifier" }, "mission": { "$ref": "mission-request.schema.json" } }, "unevaluatedProperties": false },
    "missionCommit": { "type": "object", "required": ["goal_id", "mission_id", "message"], "properties": { "goal_id": { "$ref": "common.schema.json#/$defs/identifier" }, "mission_id": { "$ref": "common.schema.json#/$defs/identifier" }, "message": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\r\\n\\u0000]+$" } }, "unevaluatedProperties": false },
    "missionIntegrate": { "type": "object", "required": ["goal_id", "mission_id", "commit_oid"], "properties": { "goal_id": { "$ref": "common.schema.json#/$defs/identifier" }, "mission_id": { "$ref": "common.schema.json#/$defs/identifier" }, "commit_oid": { "$ref": "common.schema.json#/$defs/gitOid" } }, "unevaluatedProperties": false },
    "missionTransition": { "type": "object", "required": ["goal_id", "mission_id", "status"], "properties": { "goal_id": { "$ref": "common.schema.json#/$defs/identifier" }, "mission_id": { "$ref": "common.schema.json#/$defs/identifier" }, "status": { "enum": ["ASSIGNED", "RUNNING", "BLOCKED", "COMPLETED", "CANCELLED"] } }, "unevaluatedProperties": false },
    "reportSubmit": { "type": "object", "required": ["goal_id", "report"], "properties": { "goal_id": { "$ref": "common.schema.json#/$defs/identifier" }, "report": { "$ref": "worker-report.schema.json" } }, "unevaluatedProperties": false },
    "auditApply": { "type": "object", "required": ["report"], "properties": { "report": { "$ref": "audit-report.schema.json" } }, "unevaluatedProperties": false },
    "skillRegister": { "type": "object", "required": ["skill_id", "version", "path", "artifact_digest", "validation_receipt", "audit_id"], "properties": { "skill_id": { "$ref": "common.schema.json#/$defs/identifier" }, "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "maxLength": 32 }, "path": { "$ref": "common.schema.json#/$defs/relativePath" }, "artifact_digest": { "$ref": "common.schema.json#/$defs/digest" }, "validation_receipt": { "$ref": "validation-receipt.schema.json" }, "audit_id": { "$ref": "common.schema.json#/$defs/identifier" } }, "unevaluatedProperties": false },
    "reconcile": { "type": "object", "required": ["repair"], "properties": { "repair": { "type": "boolean" } }, "unevaluatedProperties": false },
    "rollback": { "type": "object", "required": ["goal_id", "mission_id", "reason"], "properties": { "goal_id": { "$ref": "common.schema.json#/$defs/identifier" }, "mission_id": { "$ref": "common.schema.json#/$defs/identifier" }, "reason": { "$ref": "common.schema.json#/$defs/text" } }, "unevaluatedProperties": false },
    "purge": { "type": "object", "required": ["goal_id", "mission_id", "reason", "confirmation", "decision_receipt_id"], "properties": { "goal_id": { "$ref": "common.schema.json#/$defs/identifier" }, "mission_id": { "$ref": "common.schema.json#/$defs/identifier" }, "reason": { "$ref": "common.schema.json#/$defs/text" }, "confirmation": { "$ref": "common.schema.json#/$defs/identifier" }, "decision_receipt_id": { "$ref": "common.schema.json#/$defs/identifier" } }, "unevaluatedProperties": false }
  },
  "unevaluatedProperties": false
}
