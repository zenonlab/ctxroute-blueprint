{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctxroute.dev/schemas/orchestrator/model-descriptor.schema.json",
  "type": "object",
  "required": ["adapter", "model_id", "provider_family", "level", "capabilities", "context_class", "cost_class", "efforts", "access_modes", "status", "verified_at", "verification_source", "evaluation_score"],
  "properties": {
    "adapter": { "enum": ["codex", "claude", "gemini", "fixture"] },
    "model_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "provider_family": { "$ref": "common.schema.json#/$defs/identifier" },
    "level": { "enum": ["small", "balanced", "advanced", "critical"] },
    "capabilities": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "enum": ["code", "reasoning", "long-context", "structured-output", "web-research"] } },
    "context_class": { "enum": ["small", "medium", "large", "xlarge"] },
    "cost_class": { "enum": ["free", "low", "medium", "high", "unknown"] },
    "efforts": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "enum": ["none", "low", "medium", "high", "xhigh", "max"] } },
    "access_modes": { "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": { "enum": ["read-only", "workspace-write"] } },
    "status": { "enum": ["available", "unavailable", "unverified", "degraded"] },
    "verified_at": { "oneOf": [{ "$ref": "common.schema.json#/$defs/timestamp" }, { "type": "null" }] },
    "verification_source": { "oneOf": [{ "type": "string", "pattern": "^https://[^\\u0000-\\u001f]+$", "maxLength": 1024 }, { "type": "null" }] },
    "evaluation_score": { "type": "number", "minimum": 0, "maximum": 1 }
  },
  "unevaluatedProperties": false
}
