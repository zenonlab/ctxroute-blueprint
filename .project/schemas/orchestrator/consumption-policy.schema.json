{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctxroute.dev/schemas/orchestrator/consumption-policy.schema.json",
  "type": "object",
  "required": ["preset", "max_duration_ms", "max_normalized_units", "max_cost_usd", "allowed_providers", "denied_models", "prefer_local", "local_only"],
  "properties": {
    "preset": { "enum": ["economy", "balanced", "quality", "custom"] },
    "max_duration_ms": { "type": "integer", "minimum": 1000, "maximum": 86400000 },
    "max_normalized_units": { "type": "integer", "minimum": 1, "maximum": 100000 },
    "max_cost_usd": { "type": ["number", "null"], "minimum": 0 },
    "allowed_providers": { "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": { "enum": ["codex", "claude", "gemini", "fixture"] } },
    "denied_models": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/identifier" } },
    "prefer_local": { "type": "boolean" },
    "local_only": { "type": "boolean" }
  },
  "unevaluatedProperties": false
}
