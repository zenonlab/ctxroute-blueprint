{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctxroute.dev/schemas/orchestrator/documentation-requirement.schema.json",
  "type": "object",
  "required": ["requirement_id", "subject", "installed_version", "reason", "freshness", "primary_required"],
  "properties": {
    "requirement_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "subject": { "$ref": "common.schema.json#/$defs/identifier" },
    "installed_version": { "type": ["string", "null"], "maxLength": 128, "pattern": "^[^\\u0000-\\u001f]*$" },
    "reason": { "$ref": "common.schema.json#/$defs/text" },
    "freshness": { "enum": ["per-goal", "per-dispatch", "stable"] },
    "primary_required": { "type": "boolean" }
  },
  "unevaluatedProperties": false
}
