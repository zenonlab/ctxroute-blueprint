{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctxroute.dev/schemas/orchestrator/mission-view.schema.json",
  "type": "object",
  "required": ["goal_id", "goal_title", "mission_id", "skill_id", "skill_version", "file_scope", "acceptance", "validations", "response_format", "worktree"],
  "properties": {
    "goal_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "goal_title": { "$ref": "common.schema.json#/$defs/text" },
    "mission_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "skill_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "skill_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "maxLength": 32 },
    "file_scope": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/relativePath" } },
    "acceptance": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/text" } },
    "validations": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/validation" } },
    "response_format": { "const": "worker-report" },
    "worktree": { "$ref": "common.schema.json#/$defs/relativePath" }
    ,"objective": { "$ref": "common.schema.json#/$defs/text" }
    ,"dependencies": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/identifier" } }
    ,"acceptance_criteria": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/identifier" } }
    ,"skill_path": { "$ref": "common.schema.json#/$defs/relativePath" }
    ,"assessment": { "$ref": "task-assessment.schema.json" }
    ,"phase_profile": { "enum": ["work", "skillCreation", "repair"] }
    ,"documentation_evidence": { "$ref": "documentation-evidence-report.schema.json" }
    ,"documentation_freshness": { "$ref": "documentation-freshness-receipt.schema.json" }
    ,"consumption_policy": { "$ref": "consumption-policy.schema.json" }
    ,"routing_decision": { "$ref": "routing-decision.schema.json" }
    ,"escalation_criteria": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/identifier" } }
  },
  "unevaluatedProperties": false
}
