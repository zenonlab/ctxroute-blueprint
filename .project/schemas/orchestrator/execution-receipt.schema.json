{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctxroute.dev/schemas/orchestrator/execution-receipt.schema.json",
  "type": "object",
  "required": ["receipt_id", "dispatch_id", "adapter", "model_id", "provider_family", "effort", "duration_ms", "normalized_units", "input_tokens", "output_tokens", "cost_usd", "outcome", "cause"],
  "properties": {
    "receipt_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "dispatch_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "adapter": { "enum": ["codex", "claude", "gemini", "fixture"] },
    "model_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "provider_family": { "$ref": "common.schema.json#/$defs/identifier" },
    "effort": { "enum": ["none", "low", "medium", "high", "xhigh", "max"] },
    "duration_ms": { "type": "integer", "minimum": 0, "maximum": 86400000 },
    "normalized_units": { "type": "integer", "minimum": 0, "maximum": 100000 },
    "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "cost_usd": { "type": ["number", "null"], "minimum": 0 },
    "outcome": { "enum": ["success", "failed", "timed-out"] },
    "cause": { "$ref": "common.schema.json#/$defs/nullableCause" }
  },
  "unevaluatedProperties": false
}
