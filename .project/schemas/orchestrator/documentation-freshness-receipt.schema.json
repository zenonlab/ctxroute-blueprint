{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctxroute.dev/schemas/orchestrator/documentation-freshness-receipt.schema.json",
  "type": "object",
  "required": ["receipt_id", "report_id", "goal_id", "dispatch_id", "status", "checked_at", "source_digests", "cause"],
  "properties": {
    "receipt_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "report_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "goal_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "dispatch_id": { "oneOf": [{ "$ref": "common.schema.json#/$defs/identifier" }, { "type": "null" }] },
    "status": { "enum": ["CURRENT", "STALE", "NOT_APPLICABLE"] },
    "checked_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "source_digests": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/digest" } },
    "cause": { "$ref": "common.schema.json#/$defs/nullableCause" }
  },
  "unevaluatedProperties": false
}
