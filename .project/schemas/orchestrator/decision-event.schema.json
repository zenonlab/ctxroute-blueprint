{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctxroute.dev/schemas/orchestrator/decision-event.schema.json",
  "type": "object",
  "required": ["sequence", "event_id", "event_type", "operation_id", "revision_before", "revision_after", "entity_type", "entity_id", "transition", "mode", "mode_source", "skill_id", "skill_version", "validation_id", "duration_ms", "exit_code", "git_oid_before", "git_oid_after", "result", "cause", "policy_id", "schema_id", "schema_path", "keyword", "evidence_digest", "timestamp"],
  "properties": {
    "sequence": { "type": "integer", "minimum": 1 },
    "event_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "event_type": { "enum": ["TRANSACTION", "REPLAY", "CONFLICT", "TRANSITION", "VALIDATION", "AUDIT", "SKILL_REGISTRATION", "RECONCILIATION", "ROLLBACK", "PURGE", "BLOCKED", "BOOTSTRAP"] },
    "operation_id": { "oneOf": [{ "$ref": "common.schema.json#/$defs/identifier" }, { "type": "null" }] },
    "revision_before": { "type": "integer", "minimum": 0 },
    "revision_after": { "type": "integer", "minimum": 0 },
    "entity_type": { "enum": ["state", "mode", "goal", "mission", "validation", "audit", "skill", "worktree", "transaction"] },
    "entity_id": { "oneOf": [{ "$ref": "common.schema.json#/$defs/identifier" }, { "type": "null" }] },
    "transition": { "type": ["string", "null"], "maxLength": 128, "pattern": "^[A-Z_]+(?:->[A-Z_]+)?$" },
    "mode": { "type": ["string", "null"], "enum": ["SWARM_ON", "SWARM_OFF", null] },
    "mode_source": { "type": ["string", "null"], "enum": ["environment", "state", "default", null] },
    "skill_id": { "oneOf": [{ "$ref": "common.schema.json#/$defs/identifier" }, { "type": "null" }] },
    "skill_version": { "type": ["string", "null"], "maxLength": 32, "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "validation_id": { "oneOf": [{ "$ref": "common.schema.json#/$defs/identifier" }, { "type": "null" }] },
    "duration_ms": { "type": ["integer", "null"], "minimum": 0, "maximum": 300000 },
    "exit_code": { "type": ["integer", "null"], "minimum": 0, "maximum": 255 },
    "git_oid_before": { "oneOf": [{ "$ref": "common.schema.json#/$defs/gitOid" }, { "type": "null" }] },
    "git_oid_after": { "oneOf": [{ "$ref": "common.schema.json#/$defs/gitOid" }, { "type": "null" }] },
    "result": { "enum": ["SUCCESS", "FAILURE", "BLOCKED", "NO_CHANGE"] },
    "cause": { "$ref": "common.schema.json#/$defs/nullableCause" },
    "policy_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "schema_id": { "oneOf": [{ "$ref": "common.schema.json#/$defs/identifier" }, { "type": "null" }] },
    "schema_path": { "type": ["string", "null"], "maxLength": 256, "pattern": "^(?:/(?:[A-Za-z0-9._~-]+))*$" },
    "keyword": { "type": ["string", "null"], "maxLength": 64, "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
    "evidence_digest": { "oneOf": [{ "$ref": "common.schema.json#/$defs/digest" }, { "type": "null" }] },
    "timestamp": { "$ref": "common.schema.json#/$defs/timestamp" }
  },
  "unevaluatedProperties": false
}
