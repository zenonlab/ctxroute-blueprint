{
  "schemaVersion": 1,
  "status": "template",
  "tooling": {
    "runtime": "node",
    "packageManager": "npm"
  },
  "decisions": {
    "language": "not applicable: blueprint tooling only",
    "runtime": "Node.js 22.13+ for repository governance; derived product is undecided",
    "frontend": "none: no product UI is selected",
    "backend": "none: no product service is selected",
    "storage": "none: product storage is undecided; local SQLite is tooling-only",
    "deployment": "none: documentation artifacts only; derived product decides deployment",
    "observability": "CI logs and sanitized validation artifacts only",
    "security": "minimal CI permissions, pinned actions, local hooks, and Sensor gates",
    "performance": "bounded setup and single-flight local tooling; product budgets undecided"
  },
  "commands": {
    "test": "npm run test:coverage",
    "initialize": "npm run initialize",
    "lint": "npm run lint",
    "typecheck": null,
    "mutation": null,
    "integration": "npm run integration",
    "build": "npm run build:docs",
    "workspaceCheck": "npm run workspace:check",
    "crgUpdate": "npm run crg:update",
    "governanceCheck": "npm run governance:check",
    "progressRead": "npm run progress:read",
    "progressClaim": "npm run progress:claim",
    "progressValidate": "npm run progress:validate",
    "progressApprove": "npm run progress:approve",
    "progressMcp": "npm run progress:mcp",
    "progressClose": "npm run progress:close",
    "blueprintSync": "npm run blueprint:sync",
    "blueprintVersionCheck": "npm run blueprint:version:check",
    "dependencyAudit": "npm run audit:dependencies",
    "astCheck": "npm run ast:check",
    "crgMcp": "npm run crg:mcp",
    "crgSmoke": "npm run crg:smoke",
    "performance": "npm run hooks:performance",
    "sensorBlueprint": "npm run sensor:blueprint",
    "mermaid": null
  },
  "quality": {
    "sensor": {
      "languages": [
        "javascript",
        "json"
      ],
      "antiSlopEffect": "auto"
    },
    "mutation": {
      "decision": "not-applicable",
      "preCommit": false,
      "prePush": false
    }
  },
  "directories": {
    "source": [
      "packages/",
      "scripts/"
    ],
    "tests": [
      "tests/"
    ],
    "generated": [
      "coverage/",
      "dist/",
      "build/",
      ".ctxroute/state/",
      ".code-review-graph/",
      "packages/code-review-graph/.venv/"
    ]
  },
  "codeExtensions": [
    ".js",
    ".mjs",
    ".json"
  ],
  "architecture": {
    "documents": [],
    "internalDocuments": [
      "docs/architecture/src/blueprint.architecture.json",
      "docs/architecture/src/traffic.dataflow.json",
      "docs/architecture/src/sensor.dataflow.json"
    ]
  },
  "contracts": {
    "patterns": [
      "package.json",
      "**/package.json",
      "**/package-lock.json",
      "**/pnpm-lock.yaml",
      "**/yarn.lock",
      "**/bun.lock",
      "**/pyproject.toml",
      "**/requirements*.txt",
      "**/Pipfile",
      "**/poetry.lock",
      "**/uv.lock",
      "**/Cargo.toml",
      "**/Cargo.lock",
      "**/go.mod",
      "**/go.sum",
      "**/pom.xml",
      "**/build.gradle",
      "**/build.gradle.kts",
      "**/composer.json",
      "**/composer.lock",
      "**/Gemfile",
      "**/Gemfile.lock",
      "**/*.proto",
      "**/openapi*.yaml",
      "**/openapi*.yml",
      "**/openapi*.json",
      "**/*.graphql",
      "**/*.gql"
    ]
  },
  "documentation": {
    "roots": [
      "docs/",
      "documentation/",
      "specs/"
    ],
    "extensions": [
      ".md",
      ".markdown",
      ".rst",
      ".adoc",
      ".asciidoc",
      ".txt",
      ".mmd"
    ]
  },
  "starter": {
    "infrastructureRoots": [
      ".codex/",
      ".claude/",
      ".githooks/",
      ".github/",
      ".project/",
      "docs/",
      "packages/",
      "scripts/",
      "tests/",
      "tools/",
      ".devcontainer/"
    ],
    "rootFiles": [
      ".gitignore",
      "eslint.config.mjs",
      "oxlint.config.ts",
      ".mcp.json",
      ".gitmessage",
      ".gitattributes",
      "AGENTS.md",
      "CLAUDE.md",
      "CONTRIBUTING.md",
      "LICENSE",
      "NOTICE",
      "README.md",
      "SECURITY.md",
      "THIRD_PARTY_NOTICES.md",
      "ctxroute-config.json",
      "package.json",
      "package-lock.json",
      "skills-lock.json"
    ]
  }
}
