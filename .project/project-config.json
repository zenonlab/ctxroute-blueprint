{
  "schemaVersion": 1,
  "status": "initialized",
  "tooling": {
    "runtime": "node",
    "packageManager": "npm"
  },
  "decisions": {
    "language": "L1: Swift 6, observed compiler 6.3.2; later L2-L3: Rust candidate, not installed by L1. Node.js is governance tooling only.",
    "runtime": "L1: standalone macOS AppKit process, local SDK 26.5; deployment target macOS 14, qualified only on MAC-01 macOS 26.2.",
    "frontend": "L1: native AppKit and CoreGraphics; interactive diagnostic window or passive desktop. Optional --split-input tests separate widget panels above icons, not product-qualified.",
    "backend": "None for L1: no service, IPC, PTY, game reader or LLM runtime.",
    "storage": "L1: memory-only scene; build artifacts and optional own-view snapshots in ignored dist/pocs/macos-surface; bounded stdout summary.",
    "deployment": "L1: manual local SwiftPM build and launch; no installer, autostart, shell settings or wallpaper preference writes.",
    "observability": "L1: bounded diagnostic summary with draw/tick/action counters and monotonic durations, no private terminal or desktop capture.",
    "security": "L1: no external input files, commands, network or global hooks; wallpaper surface remains passive. Optional split-input panels accept local clicks above icons. Optional still export writes only own-view PNG; no system wallpaper changes. Swift compiler/tests complement lexical-only Sensor coverage.",
    "performance": "L1: no animation timer at rest or paused, 30 Hz maximum requested animation rate, finite lifetime up to 600 seconds; energy verdict deferred to measured baseline."
  },
  "commands": {
    "test": "npm run test:coverage",
    "initialize": "npm run initialize",
    "lint": "npm run lint",
    "typecheck": null,
    "mutation": null,
    "integration": "npm run integration",
    "build": "npm run build:docs",
    "workspaceCheck": "npm run workspace:check",
    "crgUpdate": "npm run crg:update",
    "governanceCheck": "npm run governance:check",
    "orchestratorRead": "npm run orchestrator:read",
    "orchestratorMcp": "npm run orchestrator:mcp",
    "orchestratorContracts": "npm run orchestrator:contracts",
    "ctxrouteQuery": "npm run ctxroute:query",
    "blueprintReview": "npm run blueprint:review",
    "astCheck": "npm run ast:check",
    "crgMcp": "npm run crg:mcp",
    "crgSmoke": "npm run crg:smoke",
    "performance": "npm run hooks:performance",
    "sensorBlueprint": "npm run sensor:blueprint",
    "mermaid": null
  },
  "quality": {
    "sensor": {
      "languages": [
        "javascript",
        "json"
      ],
      "antiSlopEffect": "auto"
    },
    "mutation": {
      "decision": "not-applicable",
      "preCommit": false,
      "prePush": false
    }
  },
  "directories": {
    "source": [
      "pocs/macos-surface/",
      "pocs/macos-native-wallpaper/",
      "packages/",
      "scripts/"
    ],
    "tests": [
      "pocs/macos-surface/Tests/",
      "tests/"
    ],
    "generated": [
      "coverage/",
      "dist/",
      "build/",
      ".ctxroute/state/",
      ".code-review-graph/",
      "packages/code-review-graph/.venv/"
    ]
  },
  "codeExtensions": [
    ".js",
    ".mjs",
    ".json"
  ],
  "architecture": {
    "documents": [
      "docs/architecture/src/macos-native-wallpaper.architecture.json",
      "docs/architecture/src/macos-surface-poc.architecture.json",
      "docs/architecture/src/product-roadmap.workflow.json",
      "docs/architecture/src/product-vision.architecture.json",
      "docs/architecture/src/game-transformation.architecture.json",
      "docs/architecture/src/runtime-infrastructure.architecture.json"
    ],
    "internalDocuments": [
      "docs/architecture/src/blueprint.architecture.json",
      "docs/architecture/src/traffic.dataflow.json",
      "docs/architecture/src/sensor.dataflow.json"
    ]
  },
  "documentation": {
    "roots": [
      "docs/",
      "documentation/",
      "specs/"
    ],
    "extensions": [
      ".md",
      ".markdown",
      ".rst",
      ".adoc",
      ".asciidoc",
      ".txt",
      ".mmd"
    ]
  },
  "contracts": {
    "patterns": [
      "**/Package.swift",
      "package.json",
      "**/package.json",
      "**/package-lock.json",
      "**/pnpm-lock.yaml",
      "**/yarn.lock",
      "**/bun.lock",
      "**/pyproject.toml",
      "**/requirements*.txt",
      "**/Pipfile",
      "**/poetry.lock",
      "**/uv.lock",
      "**/Cargo.toml",
      "**/Cargo.lock",
      "**/go.mod",
      "**/go.sum",
      "**/pom.xml",
      "**/build.gradle",
      "**/build.gradle.kts",
      "**/composer.json",
      "**/composer.lock",
      "**/Gemfile",
      "**/Gemfile.lock",
      "**/*.proto",
      "**/openapi*.yaml",
      "**/openapi*.yml",
      "**/openapi*.json",
      "**/*.graphql",
      "**/*.gql",
      "**/*.schema.json"
    ]
  },
  "starter": {
    "infrastructureRoots": [
      ".agents/",
      ".codex/",
      ".claude/",
      ".githooks/",
      ".github/",
      ".project/",
      "docs/",
      "packages/",
      "scripts/",
      "tests/",
      "tools/",
      ".devcontainer/"
    ],
    "rootFiles": [
      ".gitignore",
      "eslint.config.mjs",
      "oxlint.config.ts",
      ".mcp.json",
      ".gitmessage",
      ".gitattributes",
      "AGENTS.md",
      "CLAUDE.md",
      "CONTRIBUTING.md",
      "LICENSE",
      "NOTICE",
      "README.md",
      "SECURITY.md",
      "THIRD_PARTY_NOTICES.md",
      "ctxroute-config.json",
      "package.json",
      "package-lock.json",
      "skills-lock.json"
    ]
  }
}
