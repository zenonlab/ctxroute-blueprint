{
  "schemaVersion": 1,
  "status": "initialized",
  "tooling": {
    "runtime": "node",
    "packageManager": "npm"
  },
  "decisions": {
    "language": "JavaScript ES modules with ephemeral Python CLI integration",
    "runtime": "Node.js 22 and npm 10",
    "frontend": "none",
    "backend": "none; local CLI orchestration",
    "storage": "SQLite with WAL for local CRG state",
    "deployment": "GitHub repository and cross-platform GitHub Actions",
    "observability": "Stable JSON diagnostics and bounded lifecycle logs",
    "security": "Fixed argument vectors, no shell interpolation, AST Sensor, and ASK/NEVER/ALWAYS governance",
    "performance": "Debounced events, single-flight updates, bounded child output, and clean process termination"
  },
  "commands": {
    "test": "npm test",
    "lint": null,
    "typecheck": null,
    "mutation": null,
    "integration": null,
    "build": "npm run build:docs",
    "workspaceCheck": "npm run workspace:check",
    "mermaid": null
  },
  "quality": {
    "mutation": {
      "decision": "not-applicable",
      "preCommit": false,
      "prePush": false
    }
  },
  "directories": {
    "source": ["packages/", "scripts/"],
    "tests": ["tests/"],
    "generated": ["coverage/", "dist/", "build/", ".ctxroute/state/"]
  },
  "codeExtensions": [".js", ".mjs", ".json"],
  "architecture": {
    "documents": [
      "docs/architecture/src/blueprint.architecture.json"
    ]
  },
  "contracts": {
    "patterns": [
      "package.json",
      "**/package.json",
      "**/package-lock.json",
      "**/pnpm-lock.yaml",
      "**/yarn.lock",
      "**/bun.lock",
      "**/pyproject.toml",
      "**/requirements*.txt",
      "**/Pipfile",
      "**/poetry.lock",
      "**/uv.lock",
      "**/Cargo.toml",
      "**/Cargo.lock",
      "**/go.mod",
      "**/go.sum",
      "**/pom.xml",
      "**/build.gradle",
      "**/build.gradle.kts",
      "**/composer.json",
      "**/composer.lock",
      "**/Gemfile",
      "**/Gemfile.lock",
      "**/*.proto",
      "**/openapi*.yaml",
      "**/openapi*.yml",
      "**/openapi*.json",
      "**/*.graphql",
      "**/*.gql"
    ]
  },
  "starter": {
    "infrastructureRoots": [
      ".codex/",
      ".claude/",
      ".githooks/",
      ".github/",
      ".project/",
      "docs/",
      "rules/"
    ],
    "rootFiles": [
      ".gitignore",
      ".gitmessage",
      ".gitattributes",
      "AGENTS.md",
      "CLAUDE.md",
      "CONTRIBUTING.md",
      "LICENSE",
      "NOTICE",
      "README.md",
      "SECURITY.md",
      "THIRD_PARTY_NOTICES.md",
      "ctxroute-config.json",
      "package.json",
      "package-lock.json",
      "skills-lock.json"
    ]
  }
}
