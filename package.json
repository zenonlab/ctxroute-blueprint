{
  "name": "ctxroute-blueprint",
  "version": "1.0.0",
  "description": "Architecture-first, stack-neutral GitHub template with CTXRoute-powered agent context.",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zenonlab/ctxroute-blueprint.git"
  },
  "homepage": "https://github.com/zenonlab/ctxroute-blueprint#readme",
  "bugs": "https://github.com/zenonlab/ctxroute-blueprint/issues",
  "type": "module",
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10"
  },
  "scripts": {
    "postinstall": "node .githooks/archify restore && node .githooks/postinstall.mjs",
    "setup": "node .githooks/setup.mjs",
    "setup:check": "node .githooks/setup.mjs --check",
    "initialize": "node .githooks/initialize.mjs",
    "lint": "eslint .",
    "lint:anti-slop": "oxlint --config oxlint.config.ts .",
    "anti-slop:verify": "node scripts/check-anti-slop-snapshot.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=85 --test-coverage-branches=70 --test-coverage-functions=85 tests/*.test.mjs",
    "validate:architecture": "node .githooks/archify validate internal && node .githooks/archify validate all && node .githooks/validate-architecture.mjs --all",
    "archify:validate": "node .githooks/archify validate",
    "build:docs": "node .githooks/archify build",
    "archify:visual-check": "node .githooks/archify visual-check",
    "preview:docs": "node .githooks/archify preview",
    "sensor": "node .githooks/sensor",
    "sensor:languages": "node .githooks/sensor-languages.mjs",
    "sensor:checklist": "node .githooks/sensor --checklist",
    "sensor:blueprint": "node scripts/blueprint-sensor.mjs --summary",
    "sensor:blueprint:report": "node scripts/blueprint-sensor.mjs",
    "ast:check": "node scripts/ast-check.mjs",
    "ast:update": "node scripts/ast-update.mjs",
    "mcp:validate": "node scripts/validate-mcp-installation.mjs",
    "mcp:smoke": "node --test tests/mcp-stdio.test.mjs",
    "check:updates": "node .githooks/archify updates",
    "workspace:check": "node scripts/check-workspaces.mjs",
    "crg:build": "node scripts/crg-runner.mjs build",
    "crg:update": "node scripts/crg-runner.mjs update",
    "crg:status": "node scripts/crg-runner.mjs status",
    "crg:review": "node scripts/crg-runner.mjs review",
    "crg:mcp": "node scripts/crg-runner.mjs mcp",
    "crg:version": "node scripts/crg-runner.mjs version",
    "crg:smoke": "node scripts/crg-smoke.mjs",
    "governance:check": "node scripts/agent-governance.mjs context.scope",
    "progress:read": "node scripts/progress-cli.mjs read",
    "progress:status": "node scripts/progress-cli.mjs status",
    "progress:next": "node scripts/progress-cli.mjs next",
    "progress:update": "node scripts/progress-cli.mjs update",
    "progress:mode": "node scripts/progress-cli.mjs mode",
    "progress:validate": "node scripts/progress-cli.mjs validate-plan",
    "progress:approve": "node scripts/progress-cli.mjs approve-plan",
    "progress:mcp": "node scripts/progress-mcp.mjs",
    "validate:config": "node .githooks/validate-project-config.mjs",
    "validate:ctxroute": "node .githooks/validate-ctxroute.mjs",
    "validate:docs": "node .githooks/validate-docs.mjs",
    "validate:ui": "node .githooks/validate-ui-design.mjs",
    "validate:coherence": "node scripts/check-coherence.mjs",
    "check:coherence": "node scripts/check-coherence.mjs",
    "ci:summary": "node scripts/ci-summary.mjs",
    "validate:decisions": "node .githooks/validate-decisions.mjs",
    "integration": "node scripts/integration-check.mjs",
    "validate": "npm run validate:config && npm run validate:ctxroute && npm run validate:decisions && npm run validate:architecture && npm run validate:docs -- --all && npm run validate:ui && npm run lint && npm run anti-slop:verify && npm run sensor:languages -- status && npm run sensor:checklist && npm run ast:check && npm run mcp:validate && npm run workspace:check && npm run governance:check && npm run check:coherence && npm run sensor:blueprint && npm run test:coverage",
    "verify": "npm run validate && npm run crg:smoke && npm run integration && npm audit --audit-level=high && npm run build:docs"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@oxlint/plugins": "1.78.0",
    "ctxroute": "https://github.com/zenonlab/ctxroute/archive/76b45a57543c940c51e382a41adb749faa44bbc4.tar.gz",
    "eslint": "10.9.1",
    "ignore": "7.0.8",
    "oxlint": "1.78.0",
    "skills": "1.5.23",
    "tree-sitter": "0.21.1",
    "tree-sitter-javascript": "0.23.1",
    "tree-sitter-python": "0.21.0",
    "tree-sitter-ruby": "0.23.1",
    "tree-sitter-typescript": "0.23.2",
    "zod": "4.5.4"
  }
}
