{
  "name": "favlib",
  "private": true,
  "packageManager": "pnpm@9.15.5",
  "pnpm": {
    "overrides": {
      "postcss": "8.5.25",
      "sharp": "0.35.3"
    }
  },
  "scripts": {
    "build": "corepack pnpm --filter @favlib/extension build && corepack pnpm --filter @favlib/api build && corepack pnpm --filter @favlib/web build",
    "lint": "corepack pnpm -r lint",
    "typecheck": "corepack pnpm -r typecheck",
    "test": "corepack pnpm -r test",
    "test:e2e": "corepack pnpm --filter @favlib/api test:e2e && corepack pnpm --filter @favlib/web test:e2e",
    "test:extension:regression": "corepack pnpm --filter @favlib/extension build && corepack pnpm --filter @favlib/extension test && corepack pnpm --filter @favlib/web exec playwright test e2e/extension-popup.spec.ts --project=desktop",
    "verify:extension:downloads": "corepack pnpm --filter @favlib/extension verify:downloads",
    "doctor": "corepack pnpm --filter @favlib/api run doctor",
    "benchmark:cover-providers": "corepack pnpm --filter @favlib/api exec tsx ../../scripts/benchmark-cover-providers.ts",
    "audit:missing-covers-live": "corepack pnpm --filter @favlib/api exec tsx ../../scripts/audit-missing-covers-live-api.ts",
    "repair:favorite-catalog": "corepack pnpm --filter @favlib/api exec tsx ../../scripts/repair-favorite-catalog.ts",
    "resync:pending-reviews": "corepack pnpm --filter @favlib/api exec tsx ../../scripts/resync-pending-favorite-reviews.ts",
    "backfill:collective-reviews": "corepack pnpm --filter @favlib/api exec tsx ../../scripts/backfill-collective-review-registry.ts",
    "verify:central-config": "node scripts/check-central-config.mjs",
    "verify:provider-lexicon": "node scripts/check-provider-lexicon.mjs",
    "verify:image-safety": "node scripts/check-image-safety.mjs",
    "dev": "corepack pnpm --parallel --filter @favlib/api --filter @favlib/web dev",
    "start:local": "bash scripts/start-local.sh",
    "db:migrate": "corepack pnpm --filter @favlib/api db:migrate",
    "db:test:migrate": "bash scripts/prepare-test-db.sh",
    "test:integration": "bash scripts/test-integration.sh",
    "bootstrap": "corepack pnpm --filter @favlib/api bootstrap",
    "backup:create": "corepack pnpm --filter @favlib/api backup:create",
    "backup:verify": "corepack pnpm --filter @favlib/api backup:verify",
    "backup:restore-test": "corepack pnpm --filter @favlib/api backup:restore-test"
  }
}
