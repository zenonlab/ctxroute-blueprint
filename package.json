{
  "name": "tobirink",
  "version": "1.0.0",
  "description": "Local-first browser extension for manga and anime libraries, progress, agenda, reminders, and discovery.",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tristan-monticelli/Tobirink.git"
  },
  "homepage": "https://github.com/tristan-monticelli/Tobirink#readme",
  "bugs": "https://github.com/tristan-monticelli/Tobirink/issues",
  "type": "module",
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10"
  },
  "overrides": {
    "dompurify": "3.4.14"
  },
  "scripts": {
    "postinstall": "patch-package && node .githooks/archify restore && node .githooks/postinstall.mjs",
    "setup": "node .githooks/setup.mjs",
    "setup:check": "node .githooks/setup.mjs --check",
    "initialize": "node .githooks/initialize.mjs",
    "dev:ui-workbench": "npm run dev --workspace @tobirink/ui-workbench",
    "dev:extension": "npm run dev --workspace @tobirink/extension",
    "build:extension": "npm run build --workspace @tobirink/extension",
    "build:extension:firefox": "npm run build:firefox --workspace @tobirink/extension",
    "test:security": "npm run test:security --workspace @tobirink/extension && npm run test:security --workspace @tobirink/worker",
    "test:worker": "npm run test --workspace @tobirink/worker",
    "test:infra": "node --test scripts/infra/*.test.mjs",
    "infra:inspect": "node scripts/infra/tobirink-provider-gate.mjs inspect",
    "infra:plan": "node scripts/infra/tobirink-provider-gate.mjs plan",
    "infra:apply": "node scripts/infra/tobirink-provider-gate.mjs apply",
    "test:d1": "npm run test --workspace @tobirink/worker -- src/catalogue",
    "test:a11y": "vitest run --root apps/extension accessibility",
    "test:performance": "npm run build:extension && npm run build:extension:firefox && vitest run --root . scripts/performance --exclude 'build/**'",
    "package:extension": "node scripts/release/package-extension.mjs",
    "build:ui-workbench": "npm run build --workspace @tobirink/ui-workbench",
    "test:ui-workbench": "npm run test --workspace @tobirink/ui-workbench",
    "test:ui": "npm run test --workspace @tobirink/ui",
    "test:e2e": "npm run test --workspace @tobirink/extension --",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:domain": "npm run test --workspace @tobirink/domain",
    "test:contracts": "npm run test --workspace @tobirink/application && npm run test --workspace @tobirink/contracts",
    "test:storage": "npm run test --workspace @tobirink/adapters-indexeddb",
    "test:migrations": "npm run test:migrations --workspace @tobirink/adapters-indexeddb",
    "test:recovery": "npm run test --workspace @tobirink/application -- recovery && npm run test --workspace @tobirink/contracts -- export && npm run test --workspace @tobirink/adapters-cloudflare -- src/backup",
    "test:media": "npm run test --workspace @tobirink/adapters-cloudflare -- src/media && npm run test --workspace @tobirink/worker -- src/media",
    "test:agenda": "npm run test --workspace @tobirink/extension -- agenda-notifications && npm run test --workspace @tobirink/adapters-cloudflare -- src/releases && npm run test --workspace @tobirink/worker -- src/releases",
    "test:tasks": "npm run test --workspace @tobirink/application -- tasks && npm run test:tasks --workspace @tobirink/adapters-indexeddb",
    "lint": "eslint .",
    "lint:anti-slop": "oxlint --config oxlint.config.ts .",
    "anti-slop:verify": "node scripts/check-anti-slop-snapshot.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"tools/oxlint/**\" --test-coverage-lines=85 --test-coverage-branches=70 --test-coverage-functions=85 tests/*.test.mjs",
    "validate:architecture": "node .githooks/archify validate internal && node .githooks/archify validate all && node .githooks/validate-architecture.mjs --all",
    "archify:validate": "node .githooks/archify validate",
    "build:docs": "node .githooks/archify build",
    "archify:visual-check": "node .githooks/archify visual-check",
    "preview:docs": "node .githooks/archify preview",
    "sensor": "node .githooks/sensor",
    "sensor:languages": "node .githooks/sensor-languages.mjs",
    "sensor:checklist": "node .githooks/sensor --checklist",
    "sensor:blueprint": "node scripts/blueprint-sensor.mjs --summary",
    "sensor:blueprint:report": "node scripts/blueprint-sensor.mjs",
    "ast:check": "node scripts/ast-check.mjs",
    "ast:update": "node scripts/ast-update.mjs",
    "mcp:validate": "node scripts/validate-mcp-installation.mjs",
    "mcp:smoke": "node --test tests/mcp-stdio.test.mjs",
    "check:updates": "node .githooks/archify updates",
    "workspace:check": "node scripts/check-workspaces.mjs",
    "crg:build": "node scripts/crg-runner.mjs build",
    "crg:update": "node scripts/crg-runner.mjs update",
    "crg:status": "node scripts/crg-runner.mjs status",
    "crg:review": "node scripts/crg-runner.mjs review",
    "crg:mcp": "node scripts/crg-runner.mjs mcp",
    "crg:version": "node scripts/crg-runner.mjs version",
    "crg:smoke": "node scripts/crg-smoke.mjs",
    "governance:check": "node scripts/agent-governance.mjs context.scope",
    "progress:read": "node scripts/progress-cli.mjs read",
    "progress:status": "node scripts/progress-cli.mjs status",
    "progress:next": "node scripts/progress-cli.mjs next",
    "progress:update": "node scripts/progress-cli.mjs update",
    "progress:mode": "node scripts/progress-cli.mjs mode",
    "progress:validate": "node scripts/progress-cli.mjs validate-plan",
    "progress:approve": "node scripts/progress-cli.mjs approve-plan",
    "progress:mcp": "node scripts/progress-mcp.mjs",
    "validate:config": "node .githooks/validate-project-config.mjs",
    "validate:ctxroute": "node .githooks/validate-ctxroute.mjs",
    "validate:docs": "node .githooks/validate-docs.mjs",
    "validate:ui": "node .githooks/validate-ui-design.mjs",
    "validate:coherence": "node scripts/check-coherence.mjs",
    "check:coherence": "node scripts/check-coherence.mjs",
    "ci:summary": "node scripts/ci-summary.mjs",
    "validate:decisions": "node .githooks/validate-decisions.mjs",
    "integration": "node scripts/integration-check.mjs",
    "validate": "npm run validate:config && npm run validate:ctxroute && npm run validate:decisions && npm run validate:architecture && npm run validate:docs -- --all && npm run validate:ui && npm run lint && npm run lint:anti-slop && npm run anti-slop:verify && npm run sensor:languages -- status && npm run sensor:checklist && npm run ast:check && npm run mcp:validate && npm run workspace:check && npm run governance:check && npm run check:coherence && npm run sensor:blueprint && npm run test:infra && npm run test:coverage",
    "test:parser-equivalence": "vitest run --root . scripts/parser-equivalence",
    "verify": "npm run validate && npm run typecheck && npm test --workspaces --if-present && npm run test:parser-equivalence && npm run test:performance && npm run crg:smoke && npm run integration && npm audit --audit-level=high && npm run build:docs"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@oxlint/plugins": "1.78.0",
    "ctxroute": "https://github.com/zenonlab/ctxroute/archive/76b45a57543c940c51e382a41adb749faa44bbc4.tar.gz",
    "eslint": "10.9.1",
    "ignore": "7.0.8",
    "oxlint": "1.78.0",
    "patch-package": "8.0.1",
    "skills": "1.5.23",
    "tree-sitter": "0.21.1",
    "tree-sitter-javascript": "0.23.1",
    "tree-sitter-python": "0.21.0",
    "tree-sitter-ruby": "0.23.1",
    "tree-sitter-typescript": "0.23.2",
    "typescript": "7.0.2",
    "zod": "4.5.4"
  }
}
