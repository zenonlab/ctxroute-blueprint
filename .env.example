FAVLIB_BASE_URL=https://favlib.home.arpa
DATABASE_URL_FILE=/run/secrets/favlib_database_url
SESSION_SECRET_FILE=/run/secrets/favlib_session_secret
BACKUP_KEY_FILE=/run/secrets/favlib_backup_key
BACKUP_DESTINATION=/var/lib/favlib-backups
FAVLIB_DATA_DIR=/var/lib/favlib-data
TZ=Europe/Paris
LOG_LEVEL=info
