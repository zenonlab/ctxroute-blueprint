# Local-only environment hints for release inspection and certification.
# Copy the required names into a private .env file or export them in your shell.
# Never commit real tokens, account identifiers, or local absolute paths here.

# Cloudflare provider gate (required only for infra:inspect/plan/apply).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Extension build target. The default is https://tobirink.com.
WXT_PUBLIC_SITE_ORIGIN=https://tobirink.com

# Optional read-only FavLib checkout used by parser-equivalence tests.
FAVLIB_READONLY_ROOT=

# Optional installed-browser paths used by local certification smoke tests.
CHROME_BIN=
FIREFOX_BIN=

# Optional external web verification target.
PLAYWRIGHT_BASE_URL=https://tobirink.com

# Inject this shared gateway key only through the Cloudflare and Deno gates.
PROVIDER_GATEWAY_HMAC_KEY=

# Deno-only overlap key used briefly during an explicitly approved rotation.
PROVIDER_GATEWAY_HMAC_KEY_PREVIOUS=
