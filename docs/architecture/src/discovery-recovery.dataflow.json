    { "dot": "emerald", "title": "Conditions avant reprise", "items": ["Exiger canari corrélé, terminal et coût D1 au plus 300", "429, échec Queue ou CPU : arrêter le lot", "Comparer D1, œuvres canoniques puis Library"] }
