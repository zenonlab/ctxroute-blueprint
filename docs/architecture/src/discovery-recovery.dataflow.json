    { "from": "approval", "to": "rearm", "label": "autorise le lot exact", "classification": "confirmation immédiate", "variant": "security", "labelDy": 53 },
    { "from": "rearm", "to": "d1", "label": "admission FAILED vers PENDING", "classification": "digest recalculé identique", "variant": "emphasis", "labelDy": -23 },
    { "from": "d1", "to": "queue", "label": "signal de reprise", "classification": "une clé opaque", "variant": "emphasis" },
    { "from": "queue", "to": "collector", "label": "claim borné", "classification": "un traitement par réveil", "variant": "emphasis", "labelDy": 24 },
    { "from": "collector", "to": "library", "label": "résultat terminal", "classification": "VERIFIED ou raison", "variant": "emphasis" }
  ],
  "cards": [
    { "dot": "amber", "title": "Arrêt sans réarmement", "items": ["Canari non terminal : aucune reprise historique autorisée", "providerRequests > 0 ne suffit pas sans résultat terminal", "429, échec Queue ou dépassement CPU arrêtent le lot"] },
    { "dot": "emerald", "title": "Preuve par lot", "items": ["Comparer les états D1 avant et après", "Exiger task=discovery à 300 rows_read maximum", "Vérifier les œuvres canoniques puis Library"] }
