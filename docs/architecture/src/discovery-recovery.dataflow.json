  "nodes": [
    { "id": "snapshot", "type": "database", "label": "Export D1 frais", "sublabel": "intégrité · SHA-256", "stage": 0, "row": 0, "tag": "lecture seule" },
    { "id": "inventory", "type": "backend", "label": "Inventaire agrégé", "sublabel": "FAILED/ATTEMPT_LIMIT", "stage": 0, "row": 2, "tag": "sans titres ni clés" },
    { "id": "canaries", "type": "backend", "label": "Canaris neufs", "sublabel": "anime · manga · fournisseur", "stage": 1, "row": 0, "width": 150, "tag": "VERIFIED requis" },
    { "id": "approval", "type": "security", "label": "Confirmation ciblée", "sublabel": "lot · seuils · arrêt", "stage": 1, "row": 2, "tag": "avant écriture" },
    { "id": "rearm", "type": "backend", "label": "Resoumission API v3", "sublabel": "même clé · même payload", "stage": 2, "row": 2, "tag": "un POST · aucun SQL" },
    { "id": "d1", "type": "database", "label": "D1 Discovery v3", "sublabel": "PENDING · PROCESSING", "stage": 2, "row": 0, "tag": "cache public" },
    { "id": "queue", "type": "messagebus", "label": "Queue Discovery", "sublabel": "signal opaque · claim(1)", "stage": 3, "row": 0, "tag": "batch 1 · concurrency 1" },
    { "id": "collector", "type": "backend", "label": "Collecteur Worker", "sublabel": "fournisseur · coût D1", "stage": 3, "row": 2, "tag": "aucun faux VERIFIED" },
    { "id": "library", "type": "frontend", "label": "Library privée", "sublabel": "œuvre ou raison visible", "stage": 4, "row": 1, "tag": "contrôle après lot" }
  ],
  "flows": [
    { "from": "snapshot", "to": "canaries", "label": "base de comparaison", "classification": "lecture seule", "variant": "default", "labelDy": 53 },
    { "from": "inventory", "to": "approval", "label": "cibles éligibles", "classification": "comptes agrégés", "variant": "security" },
