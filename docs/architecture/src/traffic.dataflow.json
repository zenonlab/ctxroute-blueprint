  "cards": [
    { "dot": "cyan", "title": "Routing contract", "items": ["Nine lifecycle events inject compact context only on relevant boundaries", "Main agents use ordered memory only when useful", "Only progress workers claim parallel milestones and return a final footer"] },
    { "dot": "emerald", "title": "Traffic verification", "items": ["Session-scoped hashes isolate concurrent worker claims", "SubagentStop settles only its owned milestone and SessionEnd releases only its session", "Automatic Stop stays silent while manual is reserved for consequential review"] },
