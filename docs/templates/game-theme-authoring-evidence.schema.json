{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbite.local/schemas/game-theme-authoring-evidence-v1.json",
  "title": "Orbite typed game-theme authoring evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "records"],
  "properties": {
    "format": { "const": "orbite.game-theme-authoring-evidence/1" },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 17,
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9._-]{0,95}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "relativePath": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\:]{1,240}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "detail"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "status": { "enum": ["pass", "fail"] },
        "detail": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "gate", "verdict", "checks", "artifacts"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "gate": { "$ref": "#/$defs/id" },
        "verdict": { "enum": ["pass", "fail", "blocked"] },
        "checks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/check" }
        },
        "artifacts": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/artifact" }
        }
      }
    }
  }
}
