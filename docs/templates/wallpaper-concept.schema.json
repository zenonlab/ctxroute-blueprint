{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbite.local/schemas/wallpaper-concept-v1.json",
  "title": "Orbite researched wallpaper concept",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "id", "status", "source", "research", "inventory", "proposals", "decision", "generation_policy"],
  "properties": {
    "format": { "const": "orbite.wallpaper-concept/1" },
    "id": { "$ref": "#/$defs/id" },
    "status": { "enum": ["draft", "proposed", "accepted", "rejected"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["game_id", "input_reference", "input_sha256", "content_policy"],
      "properties": {
        "game_id": { "$ref": "#/$defs/id" },
        "input_reference": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "input_sha256": { "$ref": "#/$defs/sha256" },
        "content_policy": { "const": "private-local-only" }
      }
    },
    "research": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine_summary", "sources", "subsystems", "tool_candidates"],
      "properties": {
        "engine_summary": { "type": "string", "minLength": 20, "maxLength": 2000 },
        "sources": {
          "type": "array",
          "minItems": 2,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "classification", "reference", "revision", "usage", "commercial_assets_imported"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "classification": { "enum": ["official_documentation", "public_implementation", "local_observation", "hypothesis"] },
              "reference": { "type": "string", "minLength": 1, "maxLength": 2048 },
              "revision": { "type": "string", "minLength": 1, "maxLength": 128 },
              "usage": { "enum": ["format_research", "parser_design", "behavior_research", "render_oracle", "local_inventory"] },
              "commercial_assets_imported": { "const": false }
            }
          }
        },
        "subsystems": {
          "type": "array",
          "minItems": 13,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "status", "evidence_ids", "conversion_strategy", "fidelity_target"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "status": { "enum": ["studied", "not_applicable", "missing", "unsupported"] },
              "evidence_ids": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
              "conversion_strategy": { "type": "string", "minLength": 1, "maxLength": 1000 },
              "fidelity_target": { "enum": ["exact", "source_equivalent", "not_applicable"] }
            }
          }
        },
        "tool_candidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version", "purpose", "adoption"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "version": { "type": "string", "minLength": 1, "maxLength": 128 },
              "purpose": { "type": "string", "minLength": 1, "maxLength": 500 },
              "adoption": { "enum": ["selected", "reference_only", "rejected", "pending"] }
            }
          }
        }
      }
    },
    "inventory": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "resource_kind", "evidence_ids", "proposed_roles", "supports_session", "supports_pin", "rationale"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "label": { "type": "string", "minLength": 1, "maxLength": 120 },
          "resource_kind": { "$ref": "#/$defs/id" },
          "evidence_ids": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
          "proposed_roles": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
          "supports_session": { "type": "boolean" },
          "supports_pin": { "type": "boolean" },
          "rationale": { "type": "string", "minLength": 10, "maxLength": 1000 }
        }
      }
    },
    "proposals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "scene", "regions", "route", "interactive_object_ids", "session_bindings", "pinning", "menus", "performance"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "scene": { "type": "string", "minLength": 20, "maxLength": 2000 },
          "regions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": { "$ref": "#/$defs/region" }
          },
          "route": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode", "ordered_region_ids", "visits_each_region_once", "continuity_axes", "transition_phases", "adjacent_repetition_policy"],
            "properties": {
              "mode": { "enum": ["closed_loop", "open_sequence", "static_scene"] },
              "ordered_region_ids": { "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
              "visits_each_region_once": { "const": true },
              "continuity_axes": {
                "type": "array",
                "minItems": 1,
                "maxItems": 6,
                "uniqueItems": true,
                "items": { "enum": ["position", "orientation", "motion", "environment", "audio", "simulation"] }
              },
              "transition_phases": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
              "adjacent_repetition_policy": { "const": "reject-identical-signatures" }
            }
          },
          "interactive_object_ids": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
          "session_bindings": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["object_id", "provider_role", "intents", "identity_preserved_on_appearance_change"],
              "properties": {
                "object_id": { "$ref": "#/$defs/id" },
                "provider_role": { "$ref": "#/$defs/id" },
                "intents": { "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": { "enum": ["focus", "open"] } },
                "identity_preserved_on_appearance_change": { "const": true }
              }
            }
          },
          "pinning": {
            "type": "object",
            "additionalProperties": false,
            "required": ["candidate_ids", "visibility_scope", "same_instance_and_session", "right_click_mode", "controls", "actions", "persistent_per_object_settings", "atomic_preview"],
            "properties": {
              "candidate_ids": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
              "visibility_scope": { "const": "workspace-windows" },
              "same_instance_and_session": { "const": true },
              "right_click_mode": { "const": "transform-frame" },
              "controls": { "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": { "enum": ["position", "size", "brightness", "opacity"] } },
              "actions": { "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": { "enum": ["accept", "cancel", "disable"] } },
              "persistent_per_object_settings": { "const": true },
              "atomic_preview": { "const": true }
            }
          },
          "menus": {
            "type": "object",
            "additionalProperties": false,
            "required": ["generated_from_catalog", "generated_from_capabilities", "hardcoded_game_categories"],
            "properties": {
              "generated_from_catalog": { "const": true },
              "generated_from_capabilities": { "const": true },
              "hardcoded_game_categories": { "const": false }
            }
          },
          "performance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["static_zero_submission_target", "pause_stops_simulation", "occlusion_stops_simulation", "pin_has_independent_dirty_state"],
            "properties": {
              "static_zero_submission_target": { "const": true },
              "pause_stops_simulation": { "const": true },
              "occlusion_stops_simulation": { "const": true },
              "pin_has_independent_dirty_state": { "const": true }
            }
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "proposal_id", "decided_by", "rationale"],
      "properties": {
        "status": { "enum": ["pending", "accepted", "rejected"] },
        "proposal_id": { "type": ["string", "null"], "pattern": "^[a-zA-Z][a-zA-Z0-9._-]{0,95}$" },
        "decided_by": { "enum": ["pending", "user"] },
        "rationale": { "type": "string", "maxLength": 1000 }
      }
    },
    "generation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requires_user_accepted_plan", "requires_complete_engine_research", "on_unresolved", "commercial_content_output"],
      "properties": {
        "requires_user_accepted_plan": { "const": true },
        "requires_complete_engine_research": { "const": true },
        "on_unresolved": { "const": "block-generation" },
        "commercial_content_output": { "const": "private-only" }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9._-]{0,95}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "evidenceIds": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "qualification", "evidence_ids", "signature_axes", "signature_values", "audio", "primary_activity_id", "secondary_activity_ids", "environment_motion", "camera_cue"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "qualification": { "enum": ["verified", "unresolved"] },
        "evidence_ids": { "$ref": "#/$defs/evidenceIds" },
        "signature_axes": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "enum": ["silhouette", "audio", "actor", "environment", "camera"] }
        },
        "signature_values": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 3,
          "maxProperties": 5,
          "properties": {
            "silhouette": { "type": "string", "minLength": 10, "maxLength": 240 },
            "audio": { "type": "string", "minLength": 10, "maxLength": 240 },
            "actor": { "type": "string", "minLength": 10, "maxLength": 240 },
            "environment": { "type": "string", "minLength": 10, "maxLength": 240 },
            "camera": { "type": "string", "minLength": 10, "maxLength": 240 }
          }
        },
        "audio": {
          "type": "object",
          "additionalProperties": false,
          "required": ["identity", "resource_id", "mode", "evidence_ids"],
          "properties": {
            "identity": { "type": "string", "minLength": 1, "maxLength": 240 },
            "resource_id": { "type": ["string", "null"], "pattern": "^[a-zA-Z][a-zA-Z0-9._-]{0,95}$" },
            "mode": { "enum": ["source_track", "source_ambience", "inherited", "intentional_silence"] },
            "evidence_ids": { "$ref": "#/$defs/evidenceIds" }
          }
        },
        "primary_activity_id": { "$ref": "#/$defs/id" },
        "secondary_activity_ids": { "type": "array", "maxItems": 3, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "environment_motion": { "type": "string", "minLength": 10, "maxLength": 500 },
        "camera_cue": { "type": "string", "minLength": 10, "maxLength": 500 }
      }
    }
  }
}
