{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbite.local/schemas/correction-record-v2.json",
  "title": "Orbite correction record",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "id", "status", "symptom", "expected", "reproduction", "active_artifact_receipt", "source_relations", "source_of_truth", "trace", "hypothesis", "owner_layer", "change", "validations", "visual_qualification", "rollback"],
  "properties": {
    "format": { "const": "orbite.correction-record/2" },
    "id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9._-]{0,95}$" },
    "status": { "enum": ["draft", "failed", "blocked", "partial", "qualified"] },
    "symptom": { "type": "string", "minLength": 1, "maxLength": 500 },
    "expected": { "type": "string", "minLength": 1, "maxLength": 500 },
    "reproduction": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
    "active_artifact_receipt": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "source_relations": { "type": ["string", "null"], "maxLength": 1024 },
    "source_of_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "reference", "semantics"],
      "properties": {
        "classification": { "enum": ["source", "implementation", "observation"] },
        "reference": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "semantics": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "coordinate_space": { "type": ["string", "null"], "maxLength": 96 },
        "unit": { "type": ["string", "null"], "maxLength": 48 }
      }
    },
    "trace": { "type": "array", "minItems": 2, "maxItems": 16, "uniqueItems": true, "items": { "enum": ["source", "adapter", "canonical_contract", "package", "loader", "runtime", "connector", "renderer", "observation"] } },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "falsifier", "attempt"],
      "properties": {
        "statement": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "falsifier": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "attempt": { "type": "integer", "minimum": 1, "maximum": 2 }
      }
    },
    "owner_layer": { "enum": ["source_adapter", "canonical_contract", "runtime", "connector", "private_package"] },
    "change": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 1024 } },
    "validations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "exit_code"],
        "properties": {
          "command": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "exit_code": { "type": "integer", "minimum": 0, "maximum": 255 },
          "evidence": { "type": ["string", "null"], "maxLength": 1024 }
        }
      }
    },
    "visual_qualification": { "type": ["string", "null"], "maxLength": 1024 },
    "unknowns": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
    "rollback": { "type": "string", "minLength": 1, "maxLength": 1024 }
  }
}
