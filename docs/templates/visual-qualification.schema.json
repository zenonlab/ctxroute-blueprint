{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbite.local/schemas/visual-qualification-v1.json",
  "title": "Orbite visual qualification",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "artifact_receipt_sha256", "oracle", "captures", "verdict", "reviewer"],
  "properties": {
    "format": { "const": "orbite.visual-qualification/1" },
    "artifact_receipt_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "oracle": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "captures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "view", "instant", "path", "sha256", "result"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9._-]{0,95}$" },
          "view": { "type": "string", "minLength": 1, "maxLength": 96 },
          "instant": { "type": "string", "minLength": 1, "maxLength": 96 },
          "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "result": { "enum": ["pass", "fail", "not_observable"] },
          "note": { "type": ["string", "null"], "maxLength": 500 }
        }
      }
    },
    "verdict": { "enum": ["qualified", "failed", "non_conclusive"] },
    "reviewer": { "type": "string", "minLength": 1, "maxLength": 96 }
  }
}
