{
  "schemaVersion": 1,
  "policy": "schema-first",
  "documents": [
    {
      "id": "architecture",
      "kind": "architecture-ir",
      "audience": "internal",
      "format": "archify-json-ir",
      "source": "docs/architecture/src/blueprint.architecture.json",
      "narrative": "docs/architecture/README.md",
      "validator": "npm run validate:architecture"
    },
    {
      "id": "traffic-dataflow",
      "kind": "traffic-dataflow-ir",
      "audience": "internal",
      "format": "archify-json-ir",
      "source": "docs/architecture/src/traffic.dataflow.json",
      "narrative": "docs/architecture/README.md",
      "validator": "node .githooks/archify validate internal"
    },
    {
      "id": "sensor-dataflow",
      "kind": "sensor-dataflow-ir",
      "audience": "internal",
      "format": "archify-json-ir",
      "source": "docs/architecture/src/sensor.dataflow.json",
      "narrative": "docs/decisions/ADR-0021-honest-multilanguage-sensor-packs.md",
      "validator": "node .githooks/archify validate internal"
    },
    {
      "id": "project-brief",
      "kind": "brief",
      "format": "markdown",
      "source": "docs/00-project-brief.md",
      "requiredSections": ["Summary", "Constraints", "Decisions", "Success criteria"]
    },
    {
      "id": "technology-decisions",
      "kind": "decision-index",
      "format": "markdown",
      "source": "docs/01-technology-decisions.md"
    },
    {
      "id": "quality-strategy",
      "kind": "quality-strategy",
      "format": "markdown",
      "source": "docs/02-quality-strategy.md",
      "requiredSections": ["Quality strategy", "Decision rule"]
    },
    {
      "id": "architecture-decisions",
      "kind": "adr-corpus",
      "format": "markdown-frontmatter",
      "sourceGlob": "docs/decisions/ADR-*.md",
      "exclude": ["docs/decisions/ADR-0000-template.md"],
      "requiredMetadata": ["scope", "review"]
    },
    {
      "id": "sensor-rules",
      "kind": "versioned-rule-config",
      "format": "json",
      "source": ".project/sensor-rules.json",
      "requiredKeys": ["schemaVersion", "dangerousCommands", "sql"]
    },
    {
      "id": "sensor-baseline",
      "kind": "versioned-exception-config",
      "format": "json",
      "source": ".project/sensor-baseline.json",
      "requiredKeys": ["schemaVersion", "exceptions"],
      "validator": "npm run sensor:blueprint"
    },
    {
      "id": "ui-design-contract",
      "kind": "ui-contract",
      "format": "json",
      "source": ".project/ui-design-contract.json",
      "narrative": "docs/ui-design-contract.md",
      "requiredKeys": ["schemaVersion", "policy", "tokens", "components", "rules", "adapters"]
    },
    {
      "id": "orchestrator-configuration",
      "kind": "orchestrator-contract",
      "format": "json",
      "source": ".project/orchestrator-config.json",
      "narrative": "docs/orchestration.md",
      "requiredKeys": ["defaultMode", "statePath", "worktreeRoot", "recoveryRoot", "telemetryPath", "limits"],
      "validator": "npm run orchestrator:contracts"
    },
    {
      "id": "orchestrator-common-schema",
      "kind": "json-schema",
      "format": "json-schema-2020-12",
      "source": ".project/schemas/orchestrator/common.schema.json",
      "requiredKeys": ["$schema", "$id", "$defs"]
    },
    {
      "id": "orchestrator-config-schema",
      "kind": "json-schema",
      "format": "json-schema-2020-12",
      "source": ".project/schemas/orchestrator/config.schema.json",
      "requiredKeys": ["$schema", "$id", "unevaluatedProperties"]
    },
    {
      "id": "orchestrator-state-schema",
      "kind": "json-schema",
      "format": "json-schema-2020-12",
      "source": ".project/schemas/orchestrator/state.schema.json",
      "requiredKeys": ["$schema", "$id", "unevaluatedProperties"]
    },
    {
      "id": "orchestrator-transaction-schema",
      "kind": "json-schema",
      "format": "json-schema-2020-12",
      "source": ".project/schemas/orchestrator/transaction.schema.json",
      "requiredKeys": ["$schema", "$id", "unevaluatedProperties"]
    },
    {
      "id": "orchestrator-mission-request-schema",
      "kind": "json-schema",
      "format": "json-schema-2020-12",
      "source": ".project/schemas/orchestrator/mission-request.schema.json",
      "requiredKeys": ["$schema", "$id", "unevaluatedProperties"]
    },
    {
      "id": "orchestrator-mission-record-schema",
      "kind": "json-schema",
      "format": "json-schema-2020-12",
      "source": ".project/schemas/orchestrator/mission-record.schema.json",
      "requiredKeys": ["$schema", "$id", "unevaluatedProperties"]
    },
    {
      "id": "orchestrator-mission-view-schema",
      "kind": "json-schema",
      "format": "json-schema-2020-12",
      "source": ".project/schemas/orchestrator/mission-view.schema.json",
      "requiredKeys": ["$schema", "$id", "unevaluatedProperties"]
    },
    {
      "id": "orchestrator-worker-report-schema",
      "kind": "json-schema",
      "format": "json-schema-2020-12",
      "source": ".project/schemas/orchestrator/worker-report.schema.json",
      "requiredKeys": ["$schema", "$id", "unevaluatedProperties"]
    },
    {
      "id": "orchestrator-audit-report-schema",
      "kind": "json-schema",
      "format": "json-schema-2020-12",
      "source": ".project/schemas/orchestrator/audit-report.schema.json",
      "requiredKeys": ["$schema", "$id", "unevaluatedProperties"]
    },
    {
      "id": "orchestrator-validation-receipt-schema",
      "kind": "json-schema",
      "format": "json-schema-2020-12",
      "source": ".project/schemas/orchestrator/validation-receipt.schema.json",
      "requiredKeys": ["$schema", "$id", "unevaluatedProperties"]
    },
    {
      "id": "orchestrator-worktree-operation-schema",
      "kind": "json-schema",
      "format": "json-schema-2020-12",
      "source": ".project/schemas/orchestrator/worktree-operation.schema.json",
      "requiredKeys": ["$schema", "$id", "unevaluatedProperties"]
    },
    {
      "id": "orchestrator-decision-event-schema",
      "kind": "json-schema",
      "format": "json-schema-2020-12",
      "source": ".project/schemas/orchestrator/decision-event.schema.json",
      "requiredKeys": ["$schema", "$id", "unevaluatedProperties"]
    },
    {
      "id": "orchestrator-bootstrap-report-schema",
      "kind": "json-schema",
      "format": "json-schema-2020-12",
      "source": ".project/schemas/orchestrator/bootstrap-report.schema.json",
      "requiredKeys": ["$schema", "$id", "unevaluatedProperties"]
    },
    {
      "id": "crg-risk-acceptance-schema",
      "kind": "json-schema",
      "format": "json-schema-2020-12",
      "source": ".github/schemas/crg-risk-acceptance.schema.json",
      "narrative": "docs/ci.md",
      "requiredKeys": ["$schema", "$id", "additionalProperties"]
    },
    {
      "id": "architecture-audit",
      "kind": "architecture-audit",
      "format": "markdown",
      "source": "docs/diff/architecture-audit.md",
      "requiredSections": ["Architecture audit", "Evidence labels", "Current architecture", "Execution flows", "Findings and priorities"]
    },
    {
      "id": "target-comparison",
      "kind": "architecture-comparison",
      "format": "markdown",
      "source": "docs/diff/target-comparison.md",
      "requiredSections": ["Current-to-target comparison", "Comparison matrix", "Proposed contracts", "Priority order"]
    },
    {
      "id": "external-research",
      "kind": "research-evidence",
      "format": "markdown",
      "source": "docs/diff/external-research.md",
      "requiredSections": ["External research", "Evidence scale", "Sources", "Research limits"]
    },
    {
      "id": "risk-register",
      "kind": "risk-register",
      "format": "markdown",
      "source": "docs/diff/risk-register.md",
      "requiredSections": ["Risk register", "Scoring", "Risks", "Acceptance boundary"]
    },
    {
      "id": "validation-evidence",
      "kind": "validation-evidence",
      "format": "markdown",
      "source": "docs/diff/validation-evidence.md",
      "requiredSections": ["Validation evidence", "Environment", "Commands and results", "Proof limits"]
    }
  ]
}
