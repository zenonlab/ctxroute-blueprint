{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wallpaper-themes.local/schemas/native-probe-theme-v1.json",
  "title": "Native wallpaper probe theme",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "themeID", "sceneID", "displayName", "background", "sweep", "track", "vehicles", "panel", "actions", "anchors"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "themeID": { "type": "string", "minLength": 1 },
    "sceneID": { "type": "string", "format": "uuid" },
    "displayName": { "type": "string", "minLength": 1 },
    "background": { "$ref": "#/$defs/color" },
    "sweep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["color", "durationSeconds", "effectColor", "effectWidth"],
      "properties": {
        "color": { "$ref": "#/$defs/color" },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "effectColor": { "$ref": "#/$defs/color" },
        "effectWidth": { "type": "number", "minimum": 0 }
      }
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["centerX", "centerY", "radiusX", "radiusY", "periodSeconds", "color"],
      "properties": {
        "centerX": { "type": "number", "minimum": 0, "maximum": 1 },
        "centerY": { "type": "number", "minimum": 0, "maximum": 1 },
        "radiusX": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.5 },
        "radiusY": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.5 },
        "periodSeconds": { "type": "number", "minimum": 1 },
        "color": { "$ref": "#/$defs/color" }
      }
    },
    "vehicles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "color", "laneOffset", "trailingOffset"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "color": { "$ref": "#/$defs/color" },
          "laneOffset": { "type": "number", "minimum": -0.15, "maximum": 0.15 },
          "trailingOffset": { "type": "number", "minimum": -0.35, "maximum": 0.35 }
        }
      }
    },
    "panel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "normalizedFrame", "color"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "normalizedFrame": { "$ref": "#/$defs/frame" },
        "color": { "$ref": "#/$defs/color" }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "command", "normalizedFrame"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "command": { "enum": ["showPanel", "hidePanel", "pause", "resume", "effectOn", "effectOff", "reset"] },
          "normalizedFrame": { "$ref": "#/$defs/frame" }
        }
      }
    },
    "anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "actionID", "normalizedFrame"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "actionID": { "type": "string", "minLength": 1 },
          "normalizedFrame": { "$ref": "#/$defs/frame" }
        }
      }
    }
  },
  "$defs": {
    "color": {
      "type": "object",
      "additionalProperties": false,
      "required": ["red", "green", "blue", "alpha"],
      "properties": {
        "red": { "type": "number", "minimum": 0, "maximum": 1 },
        "green": { "type": "number", "minimum": 0, "maximum": 1 },
        "blue": { "type": "number", "minimum": 0, "maximum": 1 },
        "alpha": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    }
  }
}
