{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Orbite — fixture PoC2, pas le format de thème de production",
  "type": "object",
  "required": ["schema_version", "theme_id", "display_name", "panel_id", "background", "accent", "period_seconds", "objects", "system_controls"],
  "properties": {
    "schema_version": {"const": 1},
    "theme_id": {"$ref": "#/$defs/id"},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 80},
    "panel_id": {"$ref": "#/$defs/id"},
    "background": {"$ref": "#/$defs/color"},
    "background_asset": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}\\.png$"},
    "accent": {"$ref": "#/$defs/color"},
    "motion_path": {"enum": ["orbit", "wave", "still"]},
    "period_seconds": {"type": "number", "minimum": 4, "maximum": 120},
    "objects": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {
        "type": "object", "required": ["id", "color", "phase"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "color": {"$ref": "#/$defs/color"},
          "phase": {"type": "number", "minimum": 0, "exclusiveMaximum": 1},
          "label": {"type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$"},
          "application_bundle_id": {"$ref": "#/$defs/id"},
          "x": {"type": "number", "minimum": 0.05, "maximum": 0.95},
          "y": {"type": "number", "minimum": 0.05, "maximum": 0.95},
          "size": {"type": "number", "minimum": 24, "maximum": 96}
          ,"character": {"$ref": "#/$defs/id"}
          ,"vehicle": {"$ref": "#/$defs/id"}
          ,"texture": {"$ref": "#/$defs/asset"}
          ,"icon": {"$ref": "#/$defs/asset"}
          ,"animation": {"$ref": "#/$defs/id"}
          ,"session_id": {"$ref": "#/$defs/id"}
          ,"role": {"enum": ["theme.audio", "desktop.files", "session.focus", "object.launch", "theme.edit"]}
        },
        "dependentRequired": {"x": ["y"], "y": ["x"]}
      }
    },
    "system_controls": {
      "type": "object", "required": ["placement", "items"],
      "properties": {
        "placement": {"const": "top_left"},
        "items": {"type": "array", "minItems": 1, "maxItems": 7, "uniqueItems": true,
          "items": {"enum": ["motion", "audio", "interaction", "desktop", "brightness", "settings", "profile", "overlay"]}}
      },
      "if": {"properties": {"items": {"contains": {"const": "brightness"}}}},
      "then": {"properties": {"items": {"const": ["audio", "desktop", "brightness"]}}}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9._-]{0,95}$"},
    "color": {"type": "string", "pattern": "^[0-9A-F]{6}$"},
    "asset": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}\\.png$"}
  }
}
