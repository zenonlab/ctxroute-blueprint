{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Orbite — fixture PoC2, pas le format de thème de production",
  "type": "object",
  "required": ["schema_version", "theme_id", "display_name", "panel_id", "background", "accent", "period_seconds", "objects", "system_controls"],
  "properties": {
    "schema_version": {"const": 1},
    "theme_id": {"$ref": "#/$defs/id"},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 80},
    "panel_id": {"$ref": "#/$defs/id"},
    "background": {"$ref": "#/$defs/color"},
    "accent": {"$ref": "#/$defs/color"},
    "motion_path": {"enum": ["orbit", "wave", "still"]},
    "period_seconds": {"type": "number", "minimum": 4, "maximum": 120},
    "objects": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {
        "type": "object", "required": ["id", "color", "phase"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "color": {"$ref": "#/$defs/color"},
          "phase": {"type": "number", "minimum": 0, "exclusiveMaximum": 1}
        }
      }
    },
    "system_controls": {
      "type": "object", "required": ["placement", "items"],
      "properties": {
        "placement": {"const": "top_left"},
        "items": {"const": ["motion", "audio", "interaction", "desktop", "settings"]}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9._-]{0,95}$"},
    "color": {"type": "string", "pattern": "^[0-9A-F]{6}$"}
  }
}
