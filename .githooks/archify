import { existsSync, readFileSync, writeFileSync } from 'node:fs';
import { spawnSync } from 'node:child_process';
import { basename, join, resolve } from 'node:path';
import process from 'node:process';

const root = resolve(process.cwd());
const skill = join(root, '.agents', 'skills', 'archify');
const cli = join(skill, 'bin', 'archify.mjs');
const source = architectureSource();
const output = join(root, 'dist', 'architecture', `${basename(source, '.json')}.html`);
const command = process.argv[2] ?? 'verify';
if (command === 'restore') {
  const lockPath = join(root, 'skills-lock.json');
  const lockSource = readFileSync(lockPath);
  const pin = verifyLock();
  run(process.execPath, [join(root, 'node_modules', 'skills', 'bin', 'cli.mjs'), 'experimental_install']);
  writeFileSync(lockPath, lockSource);
  verifyInstalled(pin, true);
  run(process.execPath, [cli, 'doctor']);
}
else if (command === 'verify') { verify(); run(process.execPath, [cli, 'doctor']); }
else if (command === 'validate') { verify(); run(process.execPath, [cli, 'validate', 'architecture', source, '--quality', 'showcase', '--json']); }
else if (command === 'build') { verify(); run(process.execPath, [cli, 'deliver', 'architecture', source, output, '--quality', 'showcase', '--json']); }
