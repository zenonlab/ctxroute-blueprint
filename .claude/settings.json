{
  "hookLanes": {
    "synchronous": "host-blocking",
    "maintenance": "host-async",
    "manual": [".codex/hooks/archify-preview.mjs"]
  },
  "hookModules": {
    "entrypoints": ["lifecycle.mjs"],
    "handlers": ["ctxroute-reset.mjs", "mission-context.mjs", "post-tool-audit.mjs", "post-tool-crg.mjs", "post-tool-sensor.mjs", "pre-tool-architecture.mjs", "problem-memory.mjs", "stop-review.mjs", "worker-restitution.mjs", "worktree-reconcile.mjs"],
    "libraries": ["decision-memory.mjs", "host-policy-adapter.mjs", "lifecycle-contract.mjs", "path-extraction.mjs", "resolved-policy.mjs"],
    "manual": ["archify-preview.mjs", "ctxroute.mjs"]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ./.codex/hooks/lifecycle.mjs claude SessionStart",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "apply_patch|apply_refactor_tool|Edit|Write|exec_command|Bash|Shell",
        "hooks": [
          {
            "type": "command",
            "command": "node ./.codex/hooks/lifecycle.mjs claude PreToolUse",
            "timeout": 45
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write|exec_command|Bash|Shell",
        "hooks": [
          {
            "type": "command",
            "command": "node ./.codex/hooks/lifecycle.mjs claude PostToolUse",
            "timeout": 45
          },
          {
            "type": "command",
            "command": "node ./.codex/hooks/lifecycle.mjs claude PostToolUse maintenance",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ./.codex/hooks/lifecycle.mjs claude UserPromptSubmit",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node ./.codex/hooks/lifecycle.mjs claude UserPromptSubmit maintenance",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ./.codex/hooks/lifecycle.mjs claude PreCompact",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ./.codex/hooks/lifecycle.mjs claude Stop",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
