{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ./.codex/hooks/lifecycle.mjs claude SessionStart",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ./.codex/hooks/lifecycle.mjs claude PreToolUse",
            "timeout": 45
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write|exec_command|Bash|Shell",
        "hooks": [
          {
            "type": "command",
            "command": "node ./.codex/hooks/lifecycle.mjs claude PostToolUse",
            "timeout": 45
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ./.codex/hooks/lifecycle.mjs claude UserPromptSubmit",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ./.codex/hooks/lifecycle.mjs claude PreCompact",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ./.codex/hooks/lifecycle.mjs claude Stop",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
