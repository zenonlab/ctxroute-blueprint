{
  "compilerOptions": {
    "exactOptionalPropertyTypes": true,
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": { "@tobirink/application": ["../application/src/index.ts"], "@tobirink/domain": ["../domain/src/index.ts"] },
    "strict": true,
    "target": "ES2022"
  },
  "include": ["src/**/*.ts"]
}
